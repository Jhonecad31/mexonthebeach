---
import logoMex from "@/assets/logos/logo_notb.svg";
import logoMexNegativo from "@/assets/logos/logo-mex-negativo.svg";
import { getI18N } from "../i18n/index";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import LanguajeSelectorAstroComponent from "./Interactive/LanguajeSelector.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
const lang = getLangFromUrl(Astro.url) || "en";
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pathname = Astro.url.pathname;

interface Props {
  offI18n?: boolean;
}
const { offI18n } = Astro.props;

const cleanPath = pathname.replace(new RegExp(`^/${lang}(/|$)`), "/") || "/";

const isMenuPage = cleanPath.includes("/the-mex");
const isContactPage =
  cleanPath.includes("/contacto") ||
  cleanPath.includes("/contact") ||
  cleanPath.includes("/contato");
const isPuertoMorelos = cleanPath.includes("/puerto-morelos");

const isHomePage = cleanPath === "/";

const homeUrl = translatePath("/");
const menuUrl = translatePath("/the-mex");
const pmUrl = translatePath("/puerto-morelos");
const contactUrl = translatePath("/contact");
const bookingUrl = `${translatePath("/")}#booking`;

const navigation = [
  {
    title: i18n.NAV.home,
    link: homeUrl,
    active: isHomePage,
  },
  {
    title: i18n.NAV.reservations,
    link: menuUrl,
    active: isMenuPage,
  },
  {
    title: i18n.NAV.gallery,
    link: pmUrl,
    active: isPuertoMorelos,
  },
  {
    title: i18n.NAV.contact,
    link: contactUrl,
    active: isContactPage,
  },
];
---
<header
  class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300 ease-in-out bg-transparent text-white border-b border-transparent group/header data-[scrolled=true]:bg-[#fcfbf7] data-[scrolled=true]:text-dark data-[scrolled=true]:shadow-sm data-[scrolled=true]:border-transparent"
  id="main-header"
  data-scrolled={isContactPage ? "true" : "false"}
  data-always-scrolled={isContactPage ? "true" : "false"}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex justify-between items-center h-20"
      id="header-container-desktop"
    >
      <!-- Logo Section -->
      <a href={homeUrl} class="flex items-center space-x-2 group">
        <!-- Logo Normal -->
        <img
          src={logoMex.src}
          alt="Mex on the Beach Logo"
          class="h-15 w-auto object-contain group-hover:scale-105 transition-all duration-300 hidden group-data-[scrolled=true]/header:block"
          id="nav-logo-default"
        />
        <!-- Logo Negativo -->
        <img
          src={logoMexNegativo.src}
          alt="Mex on the Beach Logo"
          class="h-15 w-auto object-contain group-hover:scale-105 transition-all duration-300 group-data-[scrolled=true]/header:hidden"
          id="nav-logo-negative"
        />
      </a>
      <!-- Actions Group & Nav -->
      <div class="flex items-center space-x-3 sm:space-x-6 md:space-x-8">
        <!-- Desktop Nav Menu -->
        <nav
          class="hidden md:flex items-center space-x-6 text-sm font-semibold transition-colors duration-300"
        >
          {
            navigation.map((item) => (
              <a
                href={item.link}
                data-active={item.active ? "true" : "false"}
                class={`nav-link transition-colors duration-300 ${
                  item.active
                    ? "text-white group-data-[scrolled=true]/header:text-[#4e8782] group-data-[scrolled=true]/header:hover:text-primary"
                    : "text-white/80 hover:text-[#4e8782] group-data-[scrolled=true]/header:text-dark/80 group-data-[scrolled=true]/header:hover:text-[#4e8782]"
                }`}
              >
                {item.title}
              </a>
            ))
          }
        </nav>
        <div
          class="hidden md:block h-4 w-[1px] bg-current opacity-30 transition-colors duration-300"
          id="nav-divider"
        >
        </div>
        <!-- Selector de Idiomas (Desktop y Móvil) -->
        {
          !offI18n && (
            <LanguajeSelectorAstroComponent
              class="block"
              currentPath={pathname}
            />
          )
        }
        <!-- Botón CTA -->
        <a
          href={bookingUrl}
          class="hidden sm:inline-block bg-primary hover:bg-primary-hover text-white px-7 py-3 rounded-full font-bold text-xs tracking-widest uppercase shadow-sm hover:shadow-md transition-all duration-300"
        >
          {i18n.NAV.bookNow}
        </a>
        <!-- Button Open Menu Mobile -->
        <button
          type="button"
          id="menu-toggle-btn"
          class="flex items-center justify-center w-10 h-10 rounded-xl text-current hover:text-[#4e8782] hover:bg-white/10 focus:outline-none cursor-pointer transition-all duration-200 md:hidden"
          aria-label="Open menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
<!-- Drawer Mobile Backdrop -->
<div
  id="menu-backdrop"
  class="fixed inset-0 bg-dark/45 backdrop-blur-xs z-40 hidden opacity-0 transition-opacity duration-300 md:hidden"
>
</div>
<!-- Navigation Drawer Mobile -->
<div
  id="menu-drawer"
  class="fixed inset-0 w-full h-full bg-[#fcfbf7] z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col md:hidden text-dark"
>
  <!-- Drawer Header -->
  <div
    class="px-5 h-[4.5rem] flex items-center justify-between border-b border-dark/5"
  >
    <div class="w-10"></div>
    <img
      src={logoMex.src}
      alt="Mex on the Beach Logo"
      class="h-12 w-auto object-contain"
    />
    <button
      type="button"
      id="menu-close-btn"
      class="flex items-center justify-center w-10 h-10 rounded-xl text-dark hover:text-primary hover:bg-dark/5 focus:outline-none cursor-pointer transition-all duration-200"
      aria-label="Close menu"
    >
      <svg
        class="h-6 w-6 text-gray-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <!-- Drawer Body Links -->
  <nav
    class="flex-grow flex flex-col items-center justify-center gap-7 px-6 py-6 overflow-y-auto"
  >
    {
      navigation.map((item) => (
        <a
          href={item.link}
          class={`nav-drawer-link font-serif text-3xl font-bold tracking-wide transition-all duration-200 ${
            item.active
              ? "text-[#4e8782] hover:text-primary"
              : "text-dark/80 hover:text-[#4e8782]"
          }`}
        >
          {item.title}
        </a>
      ))
    }
    <div class="w-16 h-[1px] bg-gray-200 my-2"></div>
    <a
      href={bookingUrl}
      class="nav-drawer-link bg-primary hover:bg-primary-hover text-white text-center py-4 px-8 rounded-full font-bold text-xs tracking-widest uppercase shadow-md hover:shadow-lg transition-all duration-300 w-full max-w-[200px]"
    >
      {i18n.NAV.bookNow}
    </a>
  </nav>
  <!-- Drawer Footer -->
  <div
    class="p-6 text-center text-[10px] text-gray-400 uppercase tracking-widest border-t border-dark/5 bg-dark/1"
  >
    &copy; {new Date().getFullYear()} Mex on the Beach.
  </div>
</div>
<script>
  function initHeader() {
    const menuToggleBtn = document.getElementById("menu-toggle-btn");
    const menuCloseBtn = document.getElementById("menu-close-btn");
    const menuDrawer = document.getElementById("menu-drawer");
    const menuBackdrop = document.getElementById("menu-backdrop");
    const drawerLinks = document.querySelectorAll(".nav-drawer-link");
    const header = document.getElementById("main-header");
    if (!menuToggleBtn || !menuDrawer || !menuBackdrop || !header) return;
    function openMenu() {
      menuBackdrop?.classList.remove("hidden");
      void menuBackdrop?.offsetWidth;
      menuBackdrop?.classList.add("opacity-100");
      menuDrawer?.classList.remove("-translate-x-full");
      document.body.style.overflow = "hidden";
    }
    function closeMenu() {
      menuBackdrop?.classList.remove("opacity-100");
      menuDrawer?.classList.add("-translate-x-full");
      document.body.style.overflow = "";

      setTimeout(() => {
        if (!menuDrawer?.classList.contains("-translate-x-full")) return;
        menuBackdrop?.classList.add("hidden");
      }, 300);
    }
    menuToggleBtn.removeEventListener("click", openMenu);
    menuToggleBtn.addEventListener("click", openMenu);
    menuCloseBtn?.removeEventListener("click", closeMenu);
    menuCloseBtn?.addEventListener("click", closeMenu);
    menuBackdrop.removeEventListener("click", closeMenu);
    menuBackdrop.addEventListener("click", closeMenu);
    drawerLinks.forEach((link) => {
      link.removeEventListener("click", closeMenu);
      link.addEventListener("click", closeMenu);
    });
    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const isAlwaysScrolled = header.getAttribute("data-always-scrolled") === "true";
          const isScrolled = isAlwaysScrolled || window.scrollY > 20;

          header.setAttribute("data-scrolled", isScrolled ? "true" : "false");
          ticking = false;
        });
        ticking = true;
      }
    };
    handleScroll();
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll, { passive: true });
  }
  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>