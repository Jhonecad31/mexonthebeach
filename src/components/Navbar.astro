---
import logoMex from "../assets/logos/logo_notb.svg";
import { getI18N } from "../i18n/index";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import LanguajeSelectorAstroComponent from "./Interactive/LanguajeSelector.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
const lang = getLangFromUrl(Astro.url) || "en";
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Usamos de forma reactiva y exacta el pathname provisto por el contexto de Astro en cada ciclo
const pathname = Astro.url.pathname;

interface Props {
  offI18n?: boolean;
}
const { offI18n } = Astro.props;

// 1. NORMALIZACIÓN DE RUTA: Removemos el prefijo de idioma (ej: /es/contacto -> /contacto)
const cleanPath = pathname.replace(new RegExp(`^/${lang}(/|$)`), "/") || "/";

const isMenuPage = cleanPath.includes("/the-mex");
const isContactPage = cleanPath.includes("/contacto") || cleanPath.includes("/contact") || cleanPath.includes("/contato");
const isPuertoMorelos = cleanPath.includes("/puerto-morelos");

// Evaluamos de forma exacta si estamos en la raíz limpia
const isHomePage = cleanPath === "/";

// 2. GENERACIÓN DE RUTAS INTERNACIONALIZADAS
const homeUrl = translatePath("/");
const menuUrl = translatePath("/the-mex");
const pmUrl = translatePath("/puerto-morelos");
const contactUrl = translatePath("/contact");

// Mantenemos la consistencia del hash de reserva anexando el idioma actual de manera transparente
const bookingUrl = `${translatePath("/")}#booking`;

const navigation = [
  {
    title: i18n.NAV.home,
    link: homeUrl,
    active: isHomePage,
  },
  {
    title: i18n.NAV.reservations,
    link: menuUrl,
    active: isMenuPage,
  },
  {
    title: i18n.NAV.gallery,
    link: pmUrl,
    active: isPuertoMorelos,
  },
  {
    title: i18n.NAV.contact,
    link: contactUrl,
    active: isContactPage,
  },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#ede9df] glassmorphism shadow-sm"
  id="main-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20" id="header-container-desktop">
      
      <!-- Logo Section -->
      <a href={homeUrl} class="flex items-center space-x-2 group">
        <img
          src={logoMex.src}
          alt="Mex on the Beach Logo"
          class="h-15 w-auto object-contain group-hover:scale-105 transition-all duration-300"
          id="nav-logo-desktop"
        />
      </a>

      <!-- Actions Group & Nav -->
      <div class="flex items-center space-x-8">
        <!-- Desktop Nav Menu -->
        <nav class="hidden md:flex items-center space-x-6 text-sm font-semibold text-dark/70">
          {
            navigation.map((item) => (
              <a
                href={item.link}
                class={`transition-colors hover:text-[#4e8782] ${item.active ? "text-[#4e8782] font-bold" : ""}`}
              >
                {item.title}
              </a>
            ))
          }
        </nav>

        <div class="hidden md:block h-4 w-[1px] bg-gray-200"></div>

        <!-- Selector de Idiomas Desktop -->
        {!offI18n && (
          <LanguajeSelectorAstroComponent 
            class="hidden md:block" 
            currentPath={pathname} 
          />
        )}

        <!-- Botón CTA -->
        <a
          href={bookingUrl}
          class="hidden sm:inline-block bg-primary hover:bg-primary-hover text-white px-7 py-3 rounded-full font-bold text-xs tracking-widest uppercase shadow-sm hover:shadow-md transition-all duration-300"
        >
          {i18n.NAV.bookNow}
        </a>

        <!-- Button Open Menu Mobile -->
        <button
          type="button"
          id="menu-toggle-btn"
          class="flex items-center justify-center w-10 h-10 rounded-xl text-dark hover:text-[#4e8782] hover:bg-dark/5 focus:outline-none cursor-pointer transition-all duration-200 md:hidden"
          aria-label="Open menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Drawer Mobile Backdrop -->
<div
  id="menu-backdrop"
  class="fixed inset-0 bg-dark/45 backdrop-blur-xs z-40 hidden opacity-0 transition-opacity duration-300 md:hidden"
>
</div>

<!-- Navigation Drawer Mobile -->
<div
  id="menu-drawer"
  class="fixed inset-0 w-full h-full bg-[#fcfbf7] z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col md:hidden"
>
  <!-- Drawer Header -->
  <div class="px-5 h-[4.5rem] flex items-center justify-between border-b border-dark/5">
    <button
      type="button"
      id="menu-close-btn"
      class="flex items-center justify-center w-10 h-10 rounded-xl text-dark hover:text-primary hover:bg-dark/5 focus:outline-none cursor-pointer transition-all duration-200"
      aria-label="Close menu"
    >
      <svg class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img src={logoMex.src} alt="Mex on the Beach Logo" class="h-12 w-auto object-contain" />
    <div class="w-10"></div>
  </div>

  <!-- Drawer Body Links -->
  <nav class="flex-grow flex flex-col items-center justify-center gap-7 px-6 py-6 overflow-y-auto">
    {
      navigation.map((item) => (
        <a
          href={item.link}
          class={`nav-drawer-link font-serif text-3xl font-bold tracking-wide transition-all duration-200 ${item.active ? "text-primary" : "text-dark/80 hover:text-primary"}`}
        >
          {item.title}
        </a>
      ))
    }

    <div class="w-16 h-[1px] bg-gray-200 my-2"></div>
    
    <!-- Idiomas en Mobile -->
    {!offI18n && (
      <div class="text-center w-full">
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-400 block mb-3">
          {lang === "en" ? "Language" : "Idioma"}
        </span>
        <LanguajeSelectorAstroComponent 
          isMobileDrawer={true} 
          currentPath={pathname} 
        />
      </div>
    )}
    
    <div class="w-16 h-[1px] bg-gray-200 my-2"></div>
    
    <a
      href={bookingUrl}
      class="nav-drawer-link bg-primary hover:bg-primary-hover text-white text-center py-4 px-8 rounded-full font-bold text-xs tracking-widest uppercase shadow-md hover:shadow-lg transition-all duration-300 w-full max-w-[200px]"
    >
      {i18n.NAV.bookNow}
    </a>
  </nav>
  
  <div class="p-6 text-center text-[10px] text-gray-400 uppercase tracking-widest border-t border-dark/5 bg-dark/1">
    &copy; {new Date().getFullYear()} Mex on the Beach.
  </div>
</div>

<script>
  function initHeader() {
    const menuToggleBtn = document.getElementById("menu-toggle-btn");
    const menuCloseBtn = document.getElementById("menu-close-btn");
    const menuDrawer = document.getElementById("menu-drawer");
    const menuBackdrop = document.getElementById("menu-backdrop");
    const drawerLinks = document.querySelectorAll(".nav-drawer-link");
    const header = document.getElementById("main-header");

    // Validamos que los elementos críticos existan para evitar errores en consola
    if (!menuToggleBtn || !menuDrawer || !menuBackdrop) return;

    function openMenu() {
      menuBackdrop.classList.remove("hidden");
      // Forzamos un reflow antes de añadir la opacidad para que la transición CSS funcione perfectamente
      void menuBackdrop.offsetWidth; 
      
      menuBackdrop.classList.add("opacity-100");
      menuDrawer.classList.remove("-translate-x-full");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      menuBackdrop.classList.remove("opacity-100");
      menuDrawer.classList.add("-translate-x-full");
      document.body.style.overflow = "";
      
      // Esperamos a que termine la animación de opacidad antes de ocultar el fondo por completo
      setTimeout(() => {
        if (!menuDrawer.classList.contains("-translate-x-full")) return; // Previene conflictos si se reabre rápido
        menuBackdrop.classList.add("hidden");
      }, 300);
    }

    // Removemos listeners previos por si el script se vuelve a ejecutar en transiciones de página
    menuToggleBtn.removeEventListener("click", openMenu);
    menuToggleBtn.addEventListener("click", openMenu);

    menuCloseBtn?.removeEventListener("click", closeMenu);
    menuCloseBtn?.addEventListener("click", closeMenu);

    menuBackdrop.removeEventListener("click", closeMenu);
    menuBackdrop.addEventListener("click", closeMenu);

    drawerLinks.forEach(link => {
      link.removeEventListener("click", closeMenu);
      link.addEventListener("click", closeMenu);
    });

    // Control del scroll para cambiar el diseño del header
    const handleScroll = () => {
      if (window.scrollY > 50) {
        header?.classList.add("shadow-md", "bg-[#fcfbf7]");
        header?.classList.remove("bg-[#ede9df]");
      } else {
        header?.classList.remove("shadow-md", "bg-[#fcfbf7]");
        header?.classList.add("bg-[#ede9df]");
      }
    };

    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  // Asegura la ejecución inmediata tanto en la carga inicial limpia como con ViewTransitions
  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>