---
import logoMex from '../assets/logos/logo-mex.svg';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
const isMenuPage = pathname.includes('/menu');
const isContactPage = pathname.includes('/contacto') || pathname.includes('/contact');
const isPuertoMorelos = pathname.includes('/puerto-morelos');
const isHomePage = !isMenuPage && !isContactPage && !isPuertoMorelos;

function getUrlForLang(targetLang: Lang) {
  const prefix = targetLang === 'en' ? '' : `/${targetLang}`;
  
  if (isMenuPage) {
    return `${prefix}/menu`;
  }
  if (isContactPage) {
    const contactSlug = targetLang === 'en' ? 'contact' : 'contacto';
    return `${prefix}/${contactSlug}`;
  }
  if (isPuertoMorelos) {
    return `${prefix}/puerto-morelos`;
  }
  return prefix === '' ? '/' : prefix;
}

const urlEn = getUrlForLang('en');
const urlEs = getUrlForLang('es');
const urlPt = getUrlForLang('pt');

const homeUrl = lang === 'en' ? '/' : `/${lang}`;
const menuUrl = lang === 'en' ? '/menu' : `/${lang}/menu`;
const contactUrl = lang === 'en' ? '/contact' : `/${lang}/contacto`;
const pmUrl = lang === 'en' ? '/puerto-morelos' : `/${lang}/puerto-morelos`;
const bookingUrl = lang === 'en' ? '/#booking' : `/${lang}#booking`;
---
<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#ede9df] glassmorphism shadow-sm" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- DESKTOP HEADER (Visible on md and up) -->
    <div class="hidden md:flex justify-between items-center h-20" id="header-container-desktop">
      <!-- Logo Section -->
      <a href={homeUrl} class="flex items-center space-x-2 group">
        <img src={logoMex.src} alt="Mex on the Beach Logo" class="h-20 w-auto object-contain group-hover:scale-105 transition-all duration-300" id="nav-logo-desktop" />
      </a>

      <!-- Desktop Nav & Actions Group -->
      <div class="flex items-center space-x-8">
        <!-- Desktop Nav Menu -->
        <nav class="flex items-center space-x-6 text-sm font-semibold text-dark/70">
          <a href={homeUrl} class="hover:text-secondary transition-colors">{t('nav.home')}</a>
          <a href={menuUrl} class="hover:text-secondary transition-colors">{lang === 'es' ? 'Menú' : lang === 'pt' ? 'Menu' : 'Menu'}</a>
          <a href={bookingUrl} class="text-primary font-bold border-b-2 border-primary pb-0.5 transition-colors">{t('nav.reservations')}</a>
          <a href={pmUrl} class="hover:text-secondary transition-colors">Puerto Morelos</a>
          <a href={contactUrl} class="hover:text-secondary transition-colors">{t('nav.contact')}</a>
        </nav>

        <!-- Separator -->
        <div class="h-4 w-[1px] bg-gray-200"></div>
        <!-- Language Switcher Dropdown (Desktop) -->
        <div class="relative group">
          <button type="button" class="flex items-center text-sm font-semibold text-dark/70 hover:text-secondary transition-colors cursor-pointer gap-2 focus:outline-none">
            <svg class="h-5 w-5 text-gray-400 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
              <path d="M2 12h20" />
            </svg>
            <span class="tracking-wide uppercase font-bold">{lang}</span>
            <svg class="h-4 w-4 text-gray-400 group-hover:text-secondary transition-colors" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          
          <!-- Dropdown menu -->
          <div class="absolute right-0 mt-2 w-36 bg-[#fcfbf7] rounded-xl shadow-lg border border-gray-100 py-1.5 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <a href={urlEn} class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${lang === 'en' ? 'text-secondary font-bold bg-secondary/5' : 'text-dark/80 hover:bg-sand-light'}`}>
              <img 
                src="https://flagcdn.com/w40/us.png" 
                alt="EN"
                class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
              />
              English
              {lang === 'en' && <span class="ml-auto inline-flex size-1.5 rounded-full bg-secondary"></span>}
            </a>
            <a href={urlEs} class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${lang === 'es' ? 'text-secondary font-bold bg-secondary/5' : 'text-dark/80 hover:bg-sand-light'}`}>
              <img 
                src="https://flagcdn.com/w40/mx.png" 
                alt="ES"
                class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
              />
              Español
              {lang === 'es' && <span class="ml-auto inline-flex size-1.5 rounded-full bg-secondary"></span>}
            </a>
            <a href={urlPt} class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${lang === 'pt' ? 'text-secondary font-bold bg-secondary/5' : 'text-dark/80 hover:bg-sand-light'}`}>
              <img 
                src="https://flagcdn.com/w40/pt.png" 
                alt="PT"
                class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
              />
              Português
              {lang === 'pt' && <span class="ml-auto inline-flex size-1.5 rounded-full bg-secondary"></span>}
            </a>
          </div>
        </div>

        <!-- CTA Button -->
        <a href={bookingUrl} class="bg-primary hover:bg-primary-hover text-white px-7 py-3 rounded-full font-bold text-xs tracking-widest uppercase shadow-sm hover:shadow-md transition-all duration-300">
          {t('nav.bookNow')}
        </a>
      </div>
    </div>

    <!-- MOBILE HEADER -->
    <div class="grid md:hidden grid-cols-3 items-center h-16" id="header-container-mobile">
      <div class="flex items-center justify-start">
        <button type="button" id="menu-toggle-btn" class="text-dark hover:text-secondary p-2 focus:outline-none cursor-pointer transition-colors" aria-label="Open menu">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      <div class="flex items-center justify-center">
        <a href={homeUrl} class="flex items-center space-x-2 group">
          <img src={logoMex.src} alt="Mex on the Beach Logo" class="h-10 w-auto object-contain group-hover:scale-105 transition-all duration-300" id="nav-logo-mobile" />
        </a>
      </div>

      <div class="flex items-center justify-end relative" id="mobile-lang-container">
        <button type="button" id="mobile-lang-btn" class="flex items-center text-sm font-semibold text-dark/70 hover:text-secondary transition-colors cursor-pointer gap-2 focus:outline-none">
          <svg class="h-5 w-5 text-gray-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span class="tracking-wide uppercase font-bold">{lang}</span>
          <svg class="h-4 w-4 text-gray-400 transition-colors" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <div id="mobile-lang-dropdown" class="absolute right-0 top-full mt-2 w-36 bg-[#fcfbf7] rounded-xl shadow-lg border border-gray-100 py-1.5 z-50 hidden">
          <a href={urlEn} class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${lang === 'en' ? 'text-secondary font-bold bg-secondary/5' : 'text-dark/80 hover:bg-sand-light'}`}>
            <img 
              src="https://flagcdn.com/w40/us.png" 
              alt="EN"
              class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
            />
            English
            {lang === 'en' && <span class="ml-auto inline-flex size-1.5 rounded-full bg-secondary"></span>}
          </a>
          <a href={urlEs} class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${lang === 'es' ? 'text-secondary font-bold bg-secondary/5' : 'text-dark/80 hover:bg-sand-light'}`}>
            <img 
              src="https://flagcdn.com/w40/mx.png" 
              alt="ES"
              class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
            />
            Español
            {lang === 'es' && <span class="ml-auto inline-flex size-1.5 rounded-full bg-secondary"></span>}
          </a>
          <a href={urlPt} class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${lang === 'pt' ? 'text-secondary font-bold bg-secondary/5' : 'text-dark/80 hover:bg-sand-light'}`}>
            <img 
              src="https://flagcdn.com/w40/pt.png" 
              alt="PT"
              class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
            />
            Português
            {lang === 'pt' && <span class="ml-auto inline-flex size-1.5 rounded-full bg-secondary"></span>}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

  <!-- Off-canvas Navigation Drawer Backdrop (Mobile only) -->
  <div id="menu-backdrop" class="fixed inset-0 bg-dark/45 backdrop-blur-xs z-40 hidden opacity-0 transition-opacity duration-300 pointer-events-none md:hidden"></div>

  <!-- Full Screen Navigation Menu (Mobile only) -->
  <div id="menu-drawer" class="fixed inset-0 w-full h-full bg-[#fcfbf7] z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col pointer-events-none md:hidden">
    
    <!-- Drawer Header -->
    <div class="px-6 h-20 flex items-center justify-between border-b border-dark/5">
      <div class="w-10"></div> <!-- Spacer to center the logo -->
      <img src={logoMex.src} alt="Mex on the Beach Logo" class="h-20 w-auto object-contain" />
      <button type="button" id="menu-close-btn" class="text-dark hover:text-primary p-2 focus:outline-none cursor-pointer transition-colors" aria-label="Close menu">
        <svg class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Links -->
    <nav class="flex-grow flex flex-col items-center justify-center gap-7 px-6 py-6 overflow-y-auto">
      <a href={homeUrl} class={`nav-drawer-link font-serif text-3xl font-bold tracking-wide transition-all duration-200 ${isHomePage ? 'text-primary' : 'text-dark/80 hover:text-primary'}`}>
        {t('nav.home')}
      </a>

      <a href={menuUrl} class={`nav-drawer-link font-serif text-3xl font-bold tracking-wide transition-all duration-200 ${isMenuPage ? 'text-primary' : 'text-dark/80 hover:text-primary'}`}>
        {lang === 'es' ? 'Menú' : lang === 'pt' ? 'Menu' : 'Menu'}
      </a>

      <a href={pmUrl} class={`nav-drawer-link font-serif text-3xl font-bold tracking-wide transition-all duration-200 ${isPuertoMorelos ? 'text-primary' : 'text-dark/80 hover:text-primary'}`}>
        Puerto Morelos
      </a>

      <a href={contactUrl} class={`nav-drawer-link font-serif text-3xl font-bold tracking-wide transition-all duration-200 ${isContactPage ? 'text-primary' : 'text-dark/80 hover:text-primary'}`}>
        {t('nav.contact')}
      </a>

      <div class="w-16 h-[1px] bg-gray-200 my-2"></div>

      <!-- Language Selector in Drawer -->
      <div class="text-center w-full">
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-400 block mb-3">
          {lang === 'es' ? 'Idioma' : lang === 'pt' ? 'Idioma' : 'Language'}
        </span>
        <div class="flex justify-center gap-3">
          <a href={urlEn} class={`flex items-center gap-2 px-4 py-2.5 rounded-full border text-xs font-bold transition-all duration-200 ${lang === 'en' ? 'bg-secondary/10 border-secondary text-secondary shadow-xs' : 'bg-white border-gray-200 text-gray-650 hover:bg-gray-50'}`}>
            <img src="https://flagcdn.com/w40/us.png" alt="EN" class="w-4 h-3 object-cover rounded-xs border border-slate-200/50" />
            EN
          </a>
          <a href={urlEs} class={`flex items-center gap-2 px-4 py-2.5 rounded-full border text-xs font-bold transition-all duration-200 ${lang === 'es' ? 'bg-secondary/10 border-secondary text-secondary shadow-xs' : 'bg-white border-gray-200 text-gray-650 hover:bg-gray-50'}`}>
            <img src="https://flagcdn.com/w40/mx.png" alt="ES" class="w-4 h-3 object-cover rounded-xs border border-slate-200/50" />
            ES
          </a>
          <a href={urlPt} class={`flex items-center gap-2 px-4 py-2.5 rounded-full border text-xs font-bold transition-all duration-200 ${lang === 'pt' ? 'bg-secondary/10 border-secondary text-secondary shadow-xs' : 'bg-white border-gray-200 text-gray-650 hover:bg-gray-50'}`}>
            <img src="https://flagcdn.com/w40/pt.png" alt="PT" class="w-4 h-3 object-cover rounded-xs border border-slate-200/50" />
            PT
          </a>
        </div>
      </div>

      <div class="w-16 h-[1px] bg-gray-200 my-2"></div>

      <!-- Reservations CTA inside drawer -->
      <a href={bookingUrl} class="nav-drawer-link bg-primary hover:bg-primary-hover text-white text-center py-4 px-8 rounded-full font-bold text-xs tracking-widest uppercase shadow-md hover:shadow-lg transition-all duration-300 w-full max-w-[200px]">
        {t('nav.bookNow')}
      </a>
    </nav>
    <!-- Drawer Footer -->
    <div class="p-6 text-center text-[10px] text-gray-400 uppercase tracking-widest border-t border-dark/5 bg-dark/1">
      &copy; {new Date().getFullYear()} Mex on the Beach.
    </div>
  </div>

<script>
  const menuToggleBtn = document.getElementById('menu-toggle-btn');
  const menuCloseBtn = document.getElementById('menu-close-btn');
  const menuDrawer = document.getElementById('menu-drawer');
  const menuBackdrop = document.getElementById('menu-backdrop');
  const drawerLinks = document.querySelectorAll('.nav-drawer-link');

  const mobileLangBtn = document.getElementById('mobile-lang-btn');
  const mobileLangDropdown = document.getElementById('mobile-lang-dropdown');

  // Toggle mobile language dropdown
  mobileLangBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    mobileLangDropdown?.classList.toggle('hidden');
  });

  // Close mobile dropdown when clicking outside
  document.addEventListener('click', (e) => {
    const container = document.getElementById('mobile-lang-container');
    if (mobileLangDropdown && !mobileLangDropdown.classList.contains('hidden') && container && !container.contains(e.target as Node)) {
      mobileLangDropdown.classList.add('hidden');
    }
  });

  function openMenu() {
    if (menuDrawer && menuBackdrop) {
      menuBackdrop.classList.remove('hidden');
      menuDrawer.classList.remove('pointer-events-none');
      menuBackdrop.classList.remove('pointer-events-none');
      setTimeout(() => {
        menuBackdrop.classList.add('opacity-100');
        menuDrawer.classList.remove('-translate-x-full');
      }, 10);
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenu() {
    if (menuDrawer && menuBackdrop) {
      menuBackdrop.classList.remove('opacity-100');
      menuDrawer.classList.add('-translate-x-full');
      menuDrawer.classList.add('pointer-events-none');
      menuBackdrop.classList.add('pointer-events-none');
      setTimeout(() => {
        menuBackdrop.classList.add('hidden');
      }, 300);
      document.body.style.overflow = '';
    }
  }

  menuToggleBtn?.addEventListener('click', openMenu);
  menuCloseBtn?.addEventListener('click', closeMenu);
  menuBackdrop?.addEventListener('click', closeMenu);

  drawerLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Header scroll shadow and background opacity transition
  const header = document.getElementById('main-header');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('shadow-md', 'bg-[#fcfbf7]/95');
      header?.classList.remove('bg-[#fcfbf7]');
    } else {
      header?.classList.remove('shadow-md', 'bg-[#fcfbf7]/95');
      header?.classList.add('bg-[#fcfbf7]');
    }
  });
</script>