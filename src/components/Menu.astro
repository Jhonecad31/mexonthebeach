---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const wineList = [
  { key: 'white', price: '$16 / $59' },
  { key: 'rose', price: '$14 / $55' },
  { key: 'syrah', price: '$19 / $75' },
  { key: 'champagne', price: '$24 / $110' }
];

const appList = [
  { key: 'shishitos', price: '$12' },
  { key: 'guacamole', price: '$16' },
  { key: 'croquettes', price: '$22' },
  { key: 'calamari', price: '$19' }
];
---

  <Navbar lang={lang} />
  
  <main>
    <!-- 1. Hero Section -->
    <section class="relative h-[65vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/drinks-beach.webp" 
          alt="Premium Beach Drinks" 
          class="w-full h-full object-cover scale-105"
        />
      </div>
      
      <!-- Curve bottom wave -->
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,60 Q720,20 1440,60 L1440,60 L0,60 Z" fill="#ffffff"></path>
        </svg>
      </div>
    </section>

    <!-- 2. Sub-Navigation / Tabs -->
    <div class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur-md border-b border-gray-100 py-4 shadow-xs">
      <div class="max-w-4xl mx-auto px-4 flex overflow-x-auto scrollbar-none whitespace-nowrap justify-start md:justify-center gap-6 md:gap-12 text-xs font-bold tracking-widest uppercase text-gray-500">
        <a href="#cocktails" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.cocktails')}</a>
        <a href="#cuisine" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.cuisine')}</a>
        <a href="#wine" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.wine')}</a>
        <a href="#appetizers" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.appetizers')}</a>
      </div>
    </div>

    <!-- 3. Craft Cocktails Section -->
    <section id="cocktails" class="py-12 md:py-20 bg-white relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
          
          <!-- Left: Cocktails menu -->
          <div class="lg:col-span-6 space-y-8">
            <div>
              <span class="text-primary uppercase tracking-wider font-bold text-xs mb-2 block">
                {t('menu.cocktails.tag')}
              </span>
              <h2 class="font-serif text-2xl md:text-4xl font-extrabold text-secondary tracking-wider uppercase">
                {t('menu.cocktails.title')}
              </h2>
              <p class="text-gray-500 font-light mt-3 text-sm leading-relaxed max-w-md">
                {t('menu.cocktails.desc')}
              </p>
            </div>

            <!-- Items -->
            <div class="space-y-6">
              <div class="group">
                <div class="flex justify-between items-baseline gap-2">
                  <h3 class="font-serif font-bold text-base md:text-lg text-dark tracking-wide">{t('menu.cocktails.items.mule.title')}</h3>
                  <div class="flex-grow border-b border-dotted border-gray-300 mx-2 mb-1.5"></div>
                  <span class="text-primary font-bold text-base md:text-lg">$16</span>
                </div>
                <p class="text-xs text-gray-500 font-light mt-1.5 leading-relaxed">{t('menu.cocktails.items.mule.desc')}</p>
              </div>

              <div class="group">
                <div class="flex justify-between items-baseline gap-2">
                  <h3 class="font-serif font-bold text-base md:text-lg text-dark tracking-wide">{t('menu.cocktails.items.cristal.title')}</h3>
                  <div class="flex-grow border-b border-dotted border-gray-300 mx-2 mb-1.5"></div>
                  <span class="text-primary font-bold text-base md:text-lg">$22</span>
                </div>
                <p class="text-xs text-gray-500 font-light mt-1.5 leading-relaxed">{t('menu.cocktails.items.cristal.desc')}</p>
              </div>

              <div class="group">
                <div class="flex justify-between items-baseline gap-2">
                  <h3 class="font-serif font-bold text-base md:text-lg text-dark tracking-wide">{t('menu.cocktails.items.saltpeter.title')}</h3>
                  <div class="flex-grow border-b border-dotted border-gray-300 mx-2 mb-1.5"></div>
                  <span class="text-primary font-bold text-base md:text-lg">$19</span>
                </div>
                <p class="text-xs text-gray-500 font-light mt-1.5 leading-relaxed">{t('menu.cocktails.items.saltpeter.desc')}</p>
              </div>
            </div>
          </div>

          <!-- Right: Collage layout -->
          <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
            <div class="h-64 sm:h-80 md:h-[400px] overflow-hidden rounded-[30px] shadow-lg border border-gray-100 relative">
              <img 
                src="/img-drinks/drink-mango.webp" 
                alt="Orange Cocktail" 
                class="w-full h-full object-cover"
              />
            </div>
            
            <div class="flex flex-col sm:space-y-4 gap-4 sm:gap-0">
              <!-- Circle image -->
              <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full overflow-hidden border-4 border-white shadow-md mx-auto">
                <img 
                  src="/images/bartender.png" 
                  alt="Bartender mixing drinks" 
                  class="w-full h-full object-cover"
                />
              </div>
              
              <!-- Happy Hour Card -->
              <div class="bg-secondary/10 rounded-[20px] p-5 text-center shadow-sm border border-secondary/15">
                <h4 class="font-sans font-extrabold text-secondary text-xs tracking-widest uppercase mb-1.5">
                  {t('menu.cocktails.happyHour')}
                </h4>
                <p class="text-secondary/90 font-light text-[10px] sm:text-[11px] leading-relaxed">
                  {t('menu.cocktails.happyHourDesc')}
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. Coastal Cuisine Section -->
    <section id="cuisine" class="py-12 md:py-20 bg-[#fcfbf7] relative">
      <!-- Wave top shape -->
      <div class="absolute top-0 left-0 right-0 z-10 pointer-events-none">
        <svg viewBox="0 0 1440 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,0 Q720,30 1440,0 L1440,40 L0,40 Z" fill="#fcfbf7"></path>
        </svg>
      </div>

      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
          
          <!-- Left: Big Plate Image -->
          <div class="lg:col-span-6 flex justify-center">
            <div class="relative w-64 h-64 sm:w-[300px] sm:h-[300px] md:w-[380px] md:h-[380px] rounded-full overflow-hidden shadow-2xl border-4 border-white">
              <img 
                src="/img-food/IMG_5659.webp" 
                alt="Tulum Aguachile Scallops Plate" 
                class="w-full h-full object-cover scale-105"
              />
            </div>
          </div>

          <!-- Right: Food items -->
          <div class="lg:col-span-6 space-y-8">
            <div>
              <span class="text-primary uppercase tracking-wider font-bold text-xs mb-2 block">
                {t('menu.cuisine.tag')}
              </span>
              <h2 class="font-serif text-2xl md:text-4xl font-extrabold text-secondary tracking-wider uppercase">
                {t('menu.cuisine.title')}
              </h2>
            </div>

            <!-- Items -->
            <div class="space-y-6">
              <div class="group">
                <div class="flex justify-between items-baseline gap-2">
                  <h3 class="font-serif font-bold text-base md:text-lg text-dark tracking-wide">{t('menu.cuisine.items.aguachile.title')}</h3>
                  <div class="flex-grow border-b border-dotted border-gray-300 mx-2 mb-1.5"></div>
                  <span class="text-primary font-bold text-base md:text-lg">$26</span>
                </div>
                <p class="text-xs text-gray-500 font-light mt-1.5 leading-relaxed">{t('menu.cuisine.items.aguachile.desc')}</p>
              </div>

              <div class="group">
                <div class="flex justify-between items-baseline gap-2">
                  <h3 class="font-serif font-bold text-base md:text-lg text-dark tracking-wide">{t('menu.cuisine.items.pastor.title')}</h3>
                  <div class="flex-grow border-b border-dotted border-gray-300 mx-2 mb-1.5"></div>
                  <span class="text-primary font-bold text-base md:text-lg">$42</span>
                </div>
                <p class="text-xs text-gray-500 font-light mt-1.5 leading-relaxed">{t('menu.cuisine.items.pastor.desc')}</p>
              </div>

              <div class="group">
                <div class="flex justify-between items-baseline gap-2">
                  <h3 class="font-serif font-bold text-base md:text-lg text-dark tracking-wide">{t('menu.cuisine.items.snapper.title')}</h3>
                  <div class="flex-grow border-b border-dotted border-gray-300 mx-2 mb-1.5"></div>
                  <span class="text-primary font-bold text-base md:text-lg">$48</span>
                </div>
                <p class="text-xs text-gray-500 font-light mt-1.5 leading-relaxed">{t('menu.cuisine.items.snapper.desc')}</p>
              </div>
            </div>

            <!-- Reserve a table CTA -->
            <div class="pt-2">
              <a href="#booking" class="inline-block border-2 border-secondary hover:bg-secondary hover:text-white text-secondary font-bold text-xs tracking-widest uppercase px-8 py-3.5 rounded-xl transition-all duration-300">
                {t('menu.cuisine.action')}
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 5. Wine List & Appetizers Section -->
    <section class="py-16 md:py-24 bg-white relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
          
          <!-- Column 1: Wines -->
          <div id="wine" class="space-y-6 md:space-y-8">
            <div class="border-l-4 border-primary pl-4">
              <span class="text-gray-400 uppercase tracking-widest font-bold text-[10px] block">
                {t('menu.wine.tag')}
              </span>
              <h2 class="font-serif text-xl md:text-2xl font-extrabold text-secondary tracking-wider uppercase mt-1">
                {t('menu.wine.title')}
              </h2>
            </div>

            <div class="space-y-6">
              {wineList.map(item => (
                <div class="group">
                  <div class="flex justify-between items-baseline gap-2">
                    <h3 class="font-serif font-bold text-sm text-dark tracking-wide">{t(`menu.wine.items.${item.key}.title`)}</h3>
                    <div class="flex-grow border-b border-dotted border-gray-200 mx-2 mb-1"></div>
                    <span class="text-primary font-bold text-xs">{item.price}</span>
                  </div>
                  <p class="text-[11px] text-gray-400 font-light mt-1 leading-normal">{t(`menu.wine.items.${item.key}.desc`)}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Column 2: Appetizers -->
          <div id="appetizers" class="space-y-6 md:space-y-8">
            <div class="border-l-4 border-primary pl-4">
              <span class="text-gray-400 uppercase tracking-widest font-bold text-[10px] block">
                {t('menu.appetizers.tag')}
              </span>
              <h2 class="font-serif text-xl md:text-2xl font-extrabold text-secondary tracking-wider uppercase mt-1">
                {t('menu.appetizers.title')}
              </h2>
            </div>

            <div class="space-y-6">
              {appList.map(item => (
                <div class="group">
                  <div class="flex justify-between items-baseline gap-2">
                    <h3 class="font-serif font-bold text-sm text-dark tracking-wide">{t(`menu.appetizers.items.${item.key}.title`)}</h3>
                    <div class="flex-grow border-b border-dotted border-gray-200 mx-2 mb-1"></div>
                    <span class="text-primary font-bold text-xs">{item.price}</span>
                  </div>
                  <p class="text-[11px] text-gray-400 font-light mt-1 leading-normal">{t(`menu.appetizers.items.${item.key}.desc`)}</p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 6. Dark Teal CTA Banner -->
    <section class="bg-secondary relative pt-20 pb-24 md:pt-24 md:pb-28 overflow-hidden text-white">
      <!-- Top Wave shape -->
      <div class="absolute top-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,0 Q720,40 1440,0 L1440,0 L0,0 Z" fill="#ffffff"></path>
        </svg>
      </div>

      <div class="max-w-4xl mx-auto px-6 text-center relative z-10 space-y-6">
        <h2 class="font-serif text-2xl md:text-4xl font-extrabold tracking-wider uppercase">
          {t('menu.magic.title')}
        </h2>
        <p class="text-white/80 font-light text-xs md:text-base max-w-xl mx-auto leading-relaxed">
          {t('menu.magic.desc')}
        </p>
        
        <!-- Action Buttons -->
        <div class="pt-2 flex flex-wrap justify-center gap-4">
          <a href="#booking" class="inline-block bg-primary hover:bg-primary-hover text-white py-3.5 px-8 md:py-4 md:px-10 rounded-full font-bold text-xs tracking-widest uppercase shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5">
            {t('menu.magic.book')}
          </a>
          <a href="#gallery" class="inline-block border-2 border-white hover:bg-white hover:text-secondary text-white py-3 px-8 md:py-3.5 md:px-10 rounded-full font-bold text-xs tracking-widest uppercase transition-all duration-300">
            {t('menu.magic.gallery')}
          </a>
        </div>
      </div>

      <!-- Bottom Wave shape -->
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,60 Q720,20 1440,60 L1440,60 L0,60 Z" fill="#ffffff"></path>
        </svg>
      </div>
    </section>

  </main>
  
  <Footer lang={lang} />

<style>
  html {
    scroll-behavior: smooth;
  }
  
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

