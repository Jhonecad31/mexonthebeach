---
import Layout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const wineList = [
  { key: 'white', price: '$16 / $59' },
  { key: 'rose', price: '$14 / $55' },
  { key: 'syrah', price: '$19 / $75' },
  { key: 'champagne', price: '$24 / $110' }
];

const appList = [
  { key: 'shishitos', price: '$12' },
  { key: 'guacamole', price: '$16' },
  { key: 'croquettes', price: '$22' },
  { key: 'calamari', price: '$19' }
];
---

  <Navbar lang={lang} />
  
  <main>
    
    <!-- 1. Hero Section -->
    <section class="relative h-[65vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/drinks-beach.webp" 
          alt="Premium Beach Drinks" 
          class="w-full h-full object-cover scale-105"
        />
      </div>
      
      <!-- Curve bottom wave -->
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,60 Q720,20 1440,60 L1440,60 L0,60 Z" fill="#ffffff"></path>
        </svg>
      </div>
    </section>

    <!-- 2. Sub-Navigation / Tabs -->
    <div class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur-md border-b border-gray-100 py-4 shadow-xs">
      <div class="max-w-4xl mx-auto px-4 flex overflow-x-auto scrollbar-none whitespace-nowrap justify-start md:justify-center gap-6 md:gap-12 text-xs font-bold tracking-widest uppercase text-gray-500">
        <a href="#cocktails" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.cocktails')}</a>
        <a href="#cuisine" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.cuisine')}</a>
        <a href="#wine" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.wine')}</a>
        <a href="#appetizers" class="hover:text-primary transition-colors py-1 border-b-2 border-transparent hover:border-primary">{t('menu.tabs.appetizers')}</a>
      </div>
    </div>
    <!-- 6. Dark Teal CTA Banner -->
    <section class="bg-secondary relative pt-20 pb-24 md:pt-24 md:pb-28 overflow-hidden text-white">
      <!-- Top Wave shape -->
      <div class="absolute top-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,0 Q720,40 1440,0 L1440,0 L0,0 Z" fill="#ffffff"></path>
        </svg>
      </div>

      <div class="max-w-4xl mx-auto px-6 text-center relative z-10 space-y-6">
        <h2 class="font-serif text-2xl md:text-4xl font-extrabold tracking-wider uppercase">
          {t('menu.magic.title')}
        </h2>
        <p class="text-white/80 font-light text-xs md:text-base max-w-xl mx-auto leading-relaxed">
          {t('menu.magic.desc')}
        </p>
        <!-- Action Buttons -->
        <div class="pt-2 flex flex-wrap justify-center gap-4">
          <a href="#booking" class="inline-block bg-primary hover:bg-primary-hover text-white py-3.5 px-8 md:py-4 md:px-10 rounded-full font-bold text-xs tracking-widest uppercase shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5">
            {t('menu.magic.book')}
          </a>
          <a href="#gallery" class="inline-block border-2 border-white hover:bg-white hover:text-secondary text-white py-3 px-8 md:py-3.5 md:px-10 rounded-full font-bold text-xs tracking-widest uppercase transition-all duration-300">
            {t('menu.magic.gallery')}
          </a>
        </div>
      </div>

      <!-- Bottom Wave shape -->
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,60 Q720,20 1440,60 L1440,60 L0,60 Z" fill="#ffffff"></path>
        </svg>
      </div>
    </section>

  </main>
  
  <Footer lang={lang} />

<style>
  html {
    scroll-behavior: smooth;
  }
  
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

