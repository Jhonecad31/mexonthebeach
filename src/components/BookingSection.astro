---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const peopleOptions = t('booking.fields.peopleOptions') as string[];
const timeOptions = t('booking.fields.timeOptions') as string[];
const activityOptions = t('booking.fields.activityOptions') as string[];

const cabanaFeatures = t('booking.spots.cabana.features') as string[];
const sunbedsFeatures = t('booking.spots.sunbeds.features') as string[];

const promoAction = lang === 'es' ? 'Consultar Disponibilidad'
  : lang === 'pt' ? 'Verificar Disponibilidade'
  : 'Check Availability';
---
<section id="booking" class="py-24 bg-sand-light/50 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center gap-6 mb-12">
      <h2 class="font-serif text-2xl md:text-3xl font-extrabold text-dark tracking-wider uppercase whitespace-nowrap">
        {t('booking.title')}
      </h2>
      <div class="h-[1px] bg-gray-200 w-full"></div>
    </div>

    <div class="bg-white rounded-3xl p-6 shadow-[0_10px_35px_rgba(0,0,0,0.03)] mb-16 relative z-10 border border-gray-100/70">
      <form class="grid grid-cols-1 md:grid-cols-4 gap-6" onsubmit="event.preventDefault();">
        <div>
          <label class="flex items-center text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">
            <svg class="h-4 w-4 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            {t('booking.fields.people')}
          </label>
          <div class="relative">
            <select class="w-full bg-sand-light/80 border border-dark/5 text-dark/80 rounded-xl pl-4 pr-10 py-3.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-secondary/30 appearance-none cursor-pointer">
              {peopleOptions.map(option => (
                <option>{option}</option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
              <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
            </div>
          </div>
        </div>
        <div>
          <label class="flex items-center text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">
            <svg class="h-4 w-4 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {t('booking.fields.date')}
          </label>
          <input 
            type="date" 
            class="w-full bg-sand-light/80 border border-dark/5 text-dark/80 rounded-xl px-4 py-[13px] text-xs font-medium focus:outline-none focus:ring-1 focus:ring-secondary/30 cursor-pointer"
            value="2026-05-28"
          />
        </div>

        <div>
          <label class="flex items-center text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">
            <svg class="h-4 w-4 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {t('booking.fields.time')}
          </label>
          <div class="relative">
            <select class="w-full bg-sand-light/80 border border-dark/5 text-dark/80 rounded-xl pl-4 pr-10 py-3.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-secondary/30 appearance-none cursor-pointer">
              {timeOptions.map(option => (
                <option>{option}</option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
              <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
            </div>
          </div>
        </div>

        <div>
          <label class="flex items-center text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">
            <svg class="h-4 w-4 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            {t('booking.fields.activity')}
          </label>
          <div class="relative">
            <select class="w-full bg-sand-light/80 border border-dark/5 text-dark/80 rounded-xl pl-4 pr-10 py-3.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-secondary/30 appearance-none cursor-pointer">
              {activityOptions.map(option => (
                <option>{option}</option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
              <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
            </div>
          </div>
        </div>

      </form>
    </div>

    <div class="grid lg:grid-cols-2 md:grid-cols-3 gap-8 mb-12">
      <div class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100 hover:shadow-2xl transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="h-64 overflow-hidden relative">
            <img 
              src="/images/Camastos iA.webp" 
              alt="Oceanfront Cabana" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-4 left-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{t('booking.spots.popular')}</span>
          </div>
          <div class="p-6">
            <h3 class="font-serif font-bold text-xl text-dark mb-2">{t('booking.spots.cabana.title')}</h3>
            <p class="text-sm text-gray-500 font-light leading-relaxed mb-4">
              {t('booking.spots.cabana.description')}
            </p>
            <ul class="text-xs text-gray-600 font-medium space-y-2 mb-4">
              {cabanaFeatures.map(feature => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="p-6 pt-0">
          <button class="w-full border-2 border-secondary/30 hover:border-secondary text-secondary hover:bg-secondary/5 font-semibold py-3 px-4 rounded-xl text-sm transition-all duration-300 cursor-pointer">
            {t('booking.spots.details')}
          </button>
        </div>
      </div>

      <div class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100 hover:shadow-2xl transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="h-64 overflow-hidden relative">
            <img 
              src="/images/Camastos-iA2.webp" 
              alt="Premium Sunbeds" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-4 left-4 bg-secondary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{t('booking.spots.premium')}</span>
          </div>
          <div class="p-6">
            <h3 class="font-serif font-bold text-xl text-dark mb-2">{t('booking.spots.sunbeds.title')}</h3>
            <p class="text-sm text-gray-500 font-light leading-relaxed mb-4">
              {t('booking.spots.sunbeds.description')}
            </p>
            <ul class="text-xs text-gray-600 font-medium space-y-2 mb-4">
              {sunbedsFeatures.map(feature => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="p-6 pt-0">
          <button class="w-full border-2 border-secondary/30 hover:border-secondary text-secondary hover:bg-secondary/5 font-semibold py-3 px-4 rounded-xl text-sm transition-all duration-300 cursor-pointer">
            {t('booking.spots.details')}
          </button>
        </div>
      </div>
    </div>

    <div class="text-center mt-12">
      <p class="text-xs text-gray-400 mb-6 italic">
        {t('booking.disclaimer')}
      </p>
      <button onclick={`alert("${t('booking.alert')}")`} class="bg-primary hover:bg-primary-hover text-white text-base font-bold px-12 py-4 rounded-full shadow-lg transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl cursor-pointer">
        {t('booking.action')}
      </button>
    </div>
  </div>
</section>
