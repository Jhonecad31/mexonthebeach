---
import { useTranslations, type Lang } from "../i18n/utils";
import { getI18N } from "../i18n/index";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---
<section class="w-full bg-white py-24 px-4 sm:px-6 lg:px-8 flex justify-center items-center relative overflow-hidden">
  <div class="max-w-7xl w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Bloque de Texto (Izquierda) -->
    <div class="lg:col-span-6 flex flex-col items-start space-y-6 max-w-xl">
      <span class="text-primary uppercase tracking-wider font-bold text-sm block">
        {i18n.HOME.TITLE_H3.subtitle}
      </span>
      <!-- CAMBIO: text-dark -> text-secondary (verde azulado) y ajuste fluido de tamaño text-4xl/5xl -->
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold text-secondary leading-tight">
        {i18n.HOME.TITLE_H3.title}
      </h2>
      <p class="text-gray-500 font-light text-sm md:text-base leading-relaxed">
        {i18n.HOME.TITLE_H3.p1}
      </p>
      <a 
        href="/the-mex" 
        class="inline-flex items-center gap-2 text-primary hover:text-primary font-sans text-sm font-medium py-3 px-6 rounded-full transition-all duration-300 group shadow-md hover:shadow-lg"
      >
        <span>{i18n.FAVORITIES.seeFullMenu}</span>
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          fill="none" 
          viewBox="0 0 24 24" 
          stroke-width="2" 
          stroke="currentColor" 
          class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
    </div>
    
    <!-- Bloque de Imagen (Derecha) -->
    <div class="lg:col-span-6 w-full aspect-[4/3] lg:aspect-square xl:aspect-[4/3] overflow-hidden rounded-3xl shadow-sm">
      <img 
        src="/img-beach-club/mex-beach-club-signature-drinks.webp" 
        alt="Experience Puerto Morelos" 
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>

  </div>
</section>
<section
  id="booking"
  class="py-16 md:py-24 bg-white relative overflow-hidden flex flex-col justify-center items-center"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex flex-col items-center">
    
    <div class="w-full text-center mb-10 md:mb-12 max-w-3xl">
      <h2 class="font-serif text-3xl md:text-5xl font-bold text-secondary mb-3 md:mb-4 leading-tight">
        {i18n.BOOKING.title}
      </h2>
      <p class="text-gray-500 font-light mt-2 md:mt-3 text-sm md:text-base leading-relaxed max-w-2xl mx-auto px-2">
        {i18n.BOOKING.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 w-full max-w-5xl mt-2 md:mt-6">
      
      <a
        href="/experience"
        class="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full cursor-pointer border border-dark/5"
      >
        <div class="h-56 md:h-64 overflow-hidden relative flex-shrink-0">
          <img
            src="/img-beach-club/half-day-beach-pass.webp"
            alt="Oceanfront Cabana"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <span class="absolute top-4 left-4 bg-primary text-white text-[10px] md:text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
            tiltle
          </span>
        </div>

        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <h3 class="font-serif font-bold text-lg md:text-xl text-secondary mb-2 md:mb-3">
            title
          </h3>
          <p class="text-xs text-gray-500 font-light leading-relaxed mb-5 line-clamp-2">
            title
          </p>
          
          <ul class="text-xs text-gray-600 font-medium space-y-2.5 md:space-y-3 mb-6 md:mb-8 flex-grow">
            {t("BOOKING.spots.cabana.features", { returnObjects: true }).map((feature: string) => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0 mt-1.5"></span> 
                <span class="leading-tight">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto">
            <span class="block text-center w-full border-2 border-primary/30 group-hover:border-primary text-primary group-hover:bg-primary/5 font-semibold py-3 px-4 rounded-xl text-xs transition-all duration-300 uppercase tracking-wider target-touch">
              title
            </span>
          </div>
        </div>
      </a>
      
      <a
        href="/experience"
        class="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full cursor-pointer border border-dark/5"
      >
        <div class="h-56 md:h-64 overflow-hidden relative flex-shrink-0">
          <img
            src="/img-beach-club/mex-beach-club-relaxation.webp"
            alt="Premium Sunbeds"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <span class="absolute top-4 left-4 bg-secondary text-white text-[10px] md:text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
            title
          </span>
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <h3 class="font-serif font-bold text-lg md:text-xl text-secondary mb-2 md:mb-3">
            title
          </h3>
          <p class="text-xs text-gray-500 font-light leading-relaxed mb-5 line-clamp-2">
            title
          </p>
          <ul class="text-xs text-gray-600 font-medium space-y-2.5 md:space-y-3 mb-6 md:mb-8 flex-grow">
            {t("BOOKING.spots.sunbeds.features", { returnObjects: true }).map((feature: string) => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0 mt-1.5"></span> 
                <span class="leading-tight">{feature}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto">
            <span class="block text-center w-full border-2 border-secondary/30 group-hover:border-secondary text-secondary group-hover:bg-secondary/5 font-semibold py-3 px-4 rounded-xl text-xs transition-all duration-300 uppercase tracking-wider target-touch">
              title
            </span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>
