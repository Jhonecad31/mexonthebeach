---
import { useTranslations } from "../i18n/utils";
import { getI18N } from "../i18n/index";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
interface Props {
  lang?: "es" | "en";
}
const { lang = "en" } = Astro.props as Props;
const t = useTranslations(lang as "es" | "en");
---
<section
  id="booking"
  class="pt-24 pb-16 md:pt-16 md:pb-20 bg-white relative overflow-hidden flex flex-col justify-center items-center md:mt-24"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex flex-col items-center">
    {/* Cabecera principal */}
    <div class="w-full text-center mb-10 md:mb-12 max-w-3xl">
      <h2 class="font-serif text-3xl md:text-5xl font-bold text-[#4e8782] mb-3 md:mb-4 leading-tight">
        {i18n.BOOKING.title}
      </h2>
      <div
          class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed"
        >
      <p>
        {i18n.BOOKING.description}
      </p> 
      </div>
    </div>
    {/* Contenedor Grid cambiado a 3 columnas en pantallas grandes (lg:grid-cols-3) */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 w-full max-w-7xl mt-2 md:mt-6">     
      {/* CARD 1: Make-you */}
      <a
        href="/make-reservation"
        class="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full cursor-pointer border border-dark/5"
      >
        <div class="h-56 md:h-64 overflow-hidden relative flex-shrink-0">
          <img
            src="/img-beach-club/make_you_reservation.webp"
            alt="Oceanfront Cabana"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <span class="absolute top-4 left-4 bg-primary text-white text-[10px] md:text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
            {i18n.MAKE_YOU_RESERVATION.tag}
          </span>
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <h3 class="font-serif font-bold text-lg md:text-xl text-[#000000]/70 mb-2 md:mb-3">
            {i18n.MAKE_YOU_RESERVATION.title}
          </h3>
          <p class="text-xs text-gray-500 font-light leading-relaxed mb-5 line-clamp-2">
            {i18n.MAKE_YOU_RESERVATION.clock}
          </p>
          <ul class="text-xs text-gray-600 font-medium space-y-2.5 md:space-y-3 mb-6 md:mb-8 flex-grow">
            {
              (i18n.BOOKING.spots.makeReservation.features as string[]).map((feature: string) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#4e8782] flex-shrink-0 mt-1.5" />
                  <span class="leading-tight">{feature}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-auto">
            <span class="block text-center w-full border-2 border-primary/30 group-hover:border-primary text-primary group-hover:bg-primary/5 font-semibold py-3 px-4 rounded-xl text-xs transition-all duration-300 uppercase tracking-wider target-touch">
              {i18n.MAKE_YOU_RESERVATION.button}
            </span>
          </div>
        </div>
      </a>
      {/* CARD 2: Half-Day */}
      <a
        href="/half-day" 
        class="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full cursor-pointer border border-dark/5"
      >
        <div class="h-56 md:h-64 overflow-hidden relative flex-shrink-0">
          <img
            src="/img-beach-club/half-day-beach-pass.webp"
            alt="Beach Experience"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <span class="absolute top-4 left-4 bg-primary text-white text-[10px] md:text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
            {i18n.HALF_DAY_PRODUCT.tag} {/* Cambiar por tu nueva clave i18n si aplica */}
          </span>
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <h3 class="font-serif font-bold text-lg md:text-xl text-[#000000]/70 mb-2 md:mb-3">
            {i18n.HALF_DAY_PRODUCT.title} {/* Cambiar por tu nueva clave i18n si aplica */}
          </h3>
          <p class="text-xs text-gray-500 font-light leading-relaxed mb-5 line-clamp-2">
            {i18n.HALF_DAY_PRODUCT.clock} {/* Cambiar por tu nueva clave i18n si aplica */}
          </p>
          <ul class="text-xs text-gray-600 font-medium space-y-2.5 md:space-y-3 mb-6 md:mb-8 flex-grow">
            {
              (i18n.BOOKING.spots.halfDay.features as string[]).map((feature: string) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#4e8782] flex-shrink-0 mt-1.5" />
                  <span class="leading-tight">{feature}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-auto">
            <span class="block text-center w-full border-2 border-primary/30 group-hover:border-primary text-primary group-hover:bg-primary/5 font-semibold py-3 px-4 rounded-xl text-xs transition-all duration-300 uppercase tracking-wider target-touch">
              {i18n.HALF_DAY_PRODUCT.button} {/* Cambiar por tu nueva clave i18n si aplica */}
            </span>
          </div>
        </div>
      </a>
      {/* CARD 3: Full Day */}
      <a
        href="/product"
        class="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full cursor-pointer border border-dark/5"
      >
        <div class="h-56 md:h-64 overflow-hidden relative flex-shrink-0">
          <img
            src="/img-beach-club/mex-beach-club-relaxation.webp"
            alt="Premium Sunbeds"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <span class="absolute top-4 left-4 bg-[#4e8782] text-white text-[10px] md:text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
            {i18n.FULL_DAY_BEACH_EXPERIENCE.tag}
          </span>
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <h3 class="font-serif font-bold text-lg md:text-xl text-[#000000]/70 mb-2 md:mb-3">
            {i18n.FULL_DAY_BEACH_EXPERIENCE.title}
          </h3>
          <p class="text-xs text-gray-500 font-light leading-relaxed mb-5 line-clamp-2">
            {i18n.FULL_DAY_BEACH_EXPERIENCE.clock}
          </p>
          <ul class="text-xs text-gray-600 font-medium space-y-2.5 md:space-y-3 mb-6 md:mb-8 flex-grow">
            {
              (i18n.BOOKING.spots.fullDay.features as string[]).map((feature: string) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#4e8782] flex-shrink-0 mt-1.5" />
                  <span class="leading-tight">{feature}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-auto">
            <span class="block text-center w-full border-2 border-secondary/30 group-hover:border-[#4e8782] text-[#4e8782] group-hover:bg-secondary/5 font-semibold py-3 px-4 rounded-xl text-xs transition-all duration-300 uppercase tracking-wider target-touch">
              {i18n.FULL_DAY_BEACH_EXPERIENCE.button}
            </span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>