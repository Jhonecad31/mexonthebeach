---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const peopleOptions = t('booking.fields.peopleOptions') as string[];
const timeOptions = t('booking.fields.timeOptions') as string[];
const activityOptions = t('booking.fields.activityOptions') as string[];
const cabanaFeatures = t('booking.spots.cabana.features') as string[];
const sunbedsFeatures = t('booking.spots.sunbeds.features') as string[];

const promoAction = lang === 'es' ? 'Consultar Disponibilidad'
  : lang === 'pt' ? 'Verificar Disponibilidade'
  : 'Check Availability';
---
<section id="booking" class="py-24 bg-sand-light/50 relative overflow-hidden">
 <div class="grid lg:grid-cols-2 md:grid-cols-3 gap-8 mb-12">
  
  <a 
    href="/experience" 
    class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100 hover:shadow-2xl transition-all duration-300 group flex flex-col justify-between cursor-pointer"
  >
    <div>
      <div class="h-64 overflow-hidden relative">
        <img 
          src="/images/Camastos iA.webp" 
          alt="Oceanfront Cabana" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <span class="absolute top-4 left-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{t('booking.spots.popular')}</span>
      </div>
      <div class="p-6">
        <h3 class="font-serif font-bold text-xl text-dark mb-2">{t('booking.spots.cabana.title')}</h3>
        <p class="text-sm text-gray-500 font-light leading-relaxed mb-4">
          {t('booking.spots.cabana.description')}
        </p>
        <ul class="text-xs text-gray-600 font-medium space-y-2 mb-4">
          {cabanaFeatures.map(feature => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> {feature}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="p-6 pt-0">
      <span class="block text-center w-full border-2 border-secondary/30 group-hover:border-secondary text-secondary group-hover:bg-secondary/5 font-semibold py-3 px-4 rounded-xl text-sm transition-all duration-300">
        {t('booking.spots.details')}
      </span>
    </div>
  </a>
  <a 
    href="/experience" 
    class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100 hover:shadow-2xl transition-all duration-300 group flex flex-col justify-between cursor-pointer"
  >
    <div>
      <div class="h-64 overflow-hidden relative">
        <img 
          src="/images/Camastos-iA2.webp" 
          alt="Premium Sunbeds" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <span class="absolute top-4 left-4 bg-secondary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{t('booking.spots.premium')}</span>
      </div>
      <div class="p-6">
        <h3 class="font-serif font-bold text-xl text-dark mb-2">{t('booking.spots.sunbeds.title')}</h3>
        <p class="text-sm text-gray-500 font-light leading-relaxed mb-4">
          {t('booking.spots.sunbeds.description')}
        </p>
        <ul class="text-xs text-gray-600 font-medium space-y-2 mb-4">
          {sunbedsFeatures.map(feature => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> {feature}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="p-6 pt-0">
      <span class="block text-center w-full border-2 border-secondary/30 group-hover:border-secondary text-secondary group-hover:bg-secondary/5 font-semibold py-3 px-4 rounded-xl text-sm transition-all duration-300">
        {t('booking.spots.details')}
      </span>
    </div>
  </a>
</div>
</section>
