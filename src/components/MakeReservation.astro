---
import { useTranslations, type Lang } from "../i18n/utils";
import { getI18N } from "../i18n/index";
import { Check, ChevronRight, Info, X, Utensils, Camera } from "lucide-react";
import Layout from "@/layouts/BaseLayout.astro";
import FavoritiesSeccion from "@/components/sections/Favorites.astro";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const bookingUrl = lang === "en" ? "/#booking" : `/${lang}#booking`;
const carouselImages = [
  "/img-beach-club/mex-beach-club-lifestyle.webp",
  "/img-beach-club/mex-beach-club-relaxation.webp",
  "/img-beach-club/mex-beach-club-signature-drinks.webp",
];
import { Utensils, Camera, Info } from "lucide-react";
const menuCategories = [
  {
    title: i18n.MAKE_YOU_RESERVATION?.MENU?.STARTERS || "Entradas & Snacking",
    items: [
      {
        name: "Ceviche Mex on the Beach",
        price: "$320 MXN",
        desc: "Pesca del día marinada en cítricos locales, aguacate, habanero sutil y totopos artesanales.",
      },
      {
        name: "Tacos de Camarón Ensenada",
        price: "$280 MXN",
        desc: "Tres tacos en tortilla de maíz azul, camarón capeado, col morada y aderezo de chipotle.",
      },
    ],
  },
  {
    title: i18n.MAKE_YOU_RESERVATION?.MENU?.MAINS || "Platos Fuertes",
    items: [
      {
        name: "Pescado Tikin Xic",
        price: "$450 MXN",
        desc: "Clásico caribeño marinado en achiote, cocinado a las brasas y servido con arroz con coco.",
      },
      {
        name: "Hamburguesa Premium Beach",
        price: "$340 MXN",
        desc: "Corte selecto de res, queso cheddar fundido, tocino crujiente y papas trufadas.",
      },
    ],
  },
  {
    title: i18n.MAKE_YOU_RESERVATION?.MENU?.DRINKS || "Coctelería de Autor",
    items: [
      {
        name: "Mex Mojito",
        price: "$190 MXN",
        desc: "Ron blanco, hierbabuena fresca, azúcar de caña, infusión de maracuyá y un toque de agua mineral.",
      },
      {
        name: "Caribe Fling",
        price: "$210 MXN",
        desc: "Mezcal artesanal espadín, jugo de piña tatemada, jarabe de agave y escarcha de sal de gusano.",
      },
    ],
  },
];

const dishImages = [
  {
    src: "/img-beach-club/mex-beach-club-signature-drinks.webp",
    alt: "Coctelería Premium",
    label: "Mixología",
  },
  {
    src: "/img-beach-club/mex-beach-club-lifestyle.webp",
    alt: "Mariscos Frescos",
    label: "Mariscos",
  },
  {
    src: "/img-beach-club/mex-beach-club-relaxation.webp",
    alt: "Snacks junto al mar",
    label: "Snacks",
  },
];
---

<Layout>
  <div class="relative">
    {/* HERO SECTION */}
    <section
      class="relative h-[80vh] md:h-[90vh] w-full bg-[#FAF6EE] overflow-hidden flex items-center"
    >
      {/* CONTENEDOR DE IMAGEN Y CAPAS DE CONTRASTE */}
      <div
        class="absolute inset-0 z-0 overflow-hidden select-none pointer-events-none"
      >
        <img
          src="/img-beach-club/mex-beach-club-lifestyle.webp"
          alt="Puerto Morelos Aerial View"
          class="w-full h-full object-cover scale-105"
        />
        {/* Capa 1: Filtro ambiental sutil */}
        <div class="absolute inset-0 bg-black/15 z-10"></div>
        {
          /* Capa 2: Scrim premium de izquierda a derecha para proteger los textos */
        }
        <div
          class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/40 to-transparent z-10"
        >
        </div>
        {/* Capa 3: Soporte de contraste vertical exclusivo para móviles */}
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10 md:hidden"
        >
        </div>
        {/* Capa 4: Desvanecimiento limpio hacia el fondo crema de la web */}
        <div
          class="absolute inset-x-0 bottom-0 h-1/4 z-20"
          style={{
            background:
              "linear-gradient(to top, rgba(254, 251, 247, 1) 0%, rgba(254, 251, 247, 0) 100%)",
          }}
        >
        </div>
      </div>
      {/* CONTENIDO PRINCIPAL */}
      <div
        class="relative z-30 w-full max-w-6xl mx-auto px-6 md:px-12 flex flex-col items-start text-left mt-8 md:mt-0"
      >
        <div class="max-w-2xl space-y-5 md:space-y-6 animate-fade-in">
          <h1
            class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold text-white leading-[1.12] drop-shadow-[0_4px_12px_rgba(0,0,0,0.35)]"
          >
            {i18n.MAKE_YOU_RESERVATION.HERO.title}
          </h1>
          <p
            class="text-white/90 font-normal text-sm md:text-lg leading-relaxed drop-shadow-[0_2px_6px_rgba(0,0,0,0.3)] max-w-xl"
          >
            {i18n.MAKE_YOU_RESERVATION.HERO.description}
          </p>
          <div class="pt-3">
            <a
              href={bookingUrl}
              class="inline-block bg-[#E77543] hover:bg-[#d66332] text-white py-3 px-6 md:py-3.5 md:px-8 rounded-full font-bold text-[10px] md:text-xs tracking-widest uppercase shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0"
            >
              {i18n.PUERTO_MORELOS.HERO.cta || "Explorar Experiencias"}
            </a>
          </div>
        </div>
      </div>
    </section>
    <section
      class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-12"
    >
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4">
        {
          [
            {
              label: "Transportation",
              value:
                i18n.FULL_DAY_BEACH_EXPERIENCE?.transportation ||
                "Round trip transportation",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124l-.208-3.33a2.985 2.985 0 0 0-1.208-2.224l-3.235-2.426a1.5 1.5 0 0 0-.9-.3H12m7.5 6H12m7.5 0v-1.5a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5A3.375 3.375 0 0 0 9.375 3H5.625A3.375 3.375 0 0 0 2.25 6.375v8.25M12 14.25v-3.75"
                  />
                </svg>
              ),
            },
            {
              label: "Duration",
              value: i18n.FULL_DAY_BEACH_EXPERIENCE?.duration || "4 Hours",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  />
                </svg>
              ),
            },
            {
              label: "Family Friendly",
              value: i18n.FULL_DAY_BEACH_EXPERIENCE?.minAge || "For all ages",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  />
                </svg>
              ),
            },
            {
              label: "Schedules",
              value:
                i18n.FULL_DAY_BEACH_EXPERIENCE?.schedules ||
                "10:00 AM - 2:00 PM",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"
                  />
                </svg>
              ),
            },
          ].map((item, idx) => (
            <div
              key={idx}
              class="bg-[#FAF6EE] p-3 md:p-4 rounded-xl flex flex-col items-center text-center justify-center border border-stone-100"
            >
              <div class="text-[#E77543] mb-1.5 md:mb-2">{item.icon}</div>
              <span class="text-[10px] md:text-xs font-semibold tracking-wider text-stone-800 uppercase block mb-0.5">
                {item.label}
              </span>
              <span class="text-[11px] md:text-xs font-light text-stone-500">
                {item.value}
              </span>
            </div>
          ))
        }
      </div>
    </section>
    <section
      class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-12"
    >
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 items-start">
        <div class="lg:col-span-2 space-y-8 md:space-y-12">
          <div class="divide-y divide-gray-200">
            <span class="text-2xl md:text-3xl font-serif text-[#001524]">
              {i18n.MAKE_YOU_RESERVATION.WHAT_INCLUDED.title}
            </span>

            <div class="mt-8">
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
                {
                  i18n.MAKE_YOU_RESERVATION.WHAT_INCLUDED.includes.map(
                    (text) => (
                      <li class="flex items-start gap-3 text-base md:text-lg font-light text-gray-600">
                        <Check
                          className="text-[#006083] mt-1 shrink-0"
                          size={20}
                        />
                        <p>{text}</p>
                      </li>
                    ),
                  )
                }
                {
                  i18n.MAKE_YOU_RESERVATION.WHAT_INCLUDED.not_includes.map(
                    (text) => (
                      <li class="flex items-start gap-3 text-base md:text-lg font-light text-gray-600">
                        <X className="text-red-500 mt-1 shrink-0" size={20} />
                        <span>{text}</span>
                      </li>
                    ),
                  )
                }
              </ul>
            </div>
          </div>
        </div>
        {/* COLUMNA DERECHA: STICKY FORM RESERVATION */}
        <div class="lg:col-span-1 lg:sticky lg:top-24">
          <form
            id="beach-club-booking-form"
            class="bg-white rounded-2xl p-5 md:p-6 shadow-[0_4px_25px_rgba(0,0,0,0.06)] border border-stone-100 space-y-4 md:space-y-5"
          >
            {/* Seleccionar Fecha */}
            <div class="space-y-1.5">
              <label
                class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                >Select Date</label
              >
              <input
                type="date"
                name="date"
                required
                class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors"
              />
            </div>
            {/* Personas */}
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                  >Adults</label
                >
                <select
                  name="adults"
                  required
                  class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors appearance-none"
                >
                  <option value="1">1 Adult</option>
                  <option value="2" selected>2 Adults</option>
                  <option value="3">3 Adults</option>
                  <option value="4">4 Adults</option>
                  <option value="5">5 Adults</option>
                </select>
              </div>
              <div class="space-y-1.5">
                <label
                  class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                  >Children</label
                >
                <select
                  name="children"
                  class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors appearance-none"
                >
                  <option value="0" selected>0 Children</option>
                  <option value="1">1 Child</option>
                  <option value="2">2 Children</option>
                  <option value="3">3 Children</option>
                </select>
              </div>
            </div>
            {/* Nombre Completo */}
            <div class="space-y-1.5">
              <label
                class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                >Full name</label
              >
              <input
                type="text"
                name="fullName"
                placeholder="Enter your full name"
                required
                class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors"
              />
            </div>
            {/* Teléfono */}
            <div class="space-y-1.5">
              <label
                class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                >Phone</label
              >
              <input
                type="tel"
                name="phone"
                placeholder="Enter your phone number"
                required
                class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors"
              />
            </div>
            {/* Email */}
            <div class="space-y-1.5">
              <label
                class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                >Email</label
              >
              <input
                type="email"
                name="email"
                placeholder="Enter your email"
                required
                class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors"
              />
            </div>

            {/* Mensaje */}
            <div class="space-y-1.5">
              <label
                class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-stone-700"
                >Message</label
              >
              <textarea
                name="message"
                rows="3"
                placeholder="Any special requests?..."
                class="w-full bg-[#FAF6EE] text-stone-700 text-xs md:text-sm rounded-xl px-3 py-2.5 md:px-4 md:py-3 border border-stone-200/60 focus:outline-none focus:border-[#4e8782] focus:ring-1 focus:ring-[#4e8782] transition-colors resize-none"
              ></textarea>
            </div>
            {/* Botón de envío */}
            <button
              type="submit"
              id="submit-booking-btn"
              class="w-full bg-[#E77543] hover:bg-[#d66332] text-white text-xs md:text-sm font-bold tracking-wider uppercase py-3.5 rounded-xl transition-all shadow-md shadow-orange-700/10 active:scale-[0.99] mt-2"
            >
              Request Reservation
            </button>
          </form>
        </div>
        <script>
          const form = document.getElementById(
            "beach-club-booking-form",
          ) as HTMLFormElement;
          const submitBtn = document.getElementById(
            "submit-booking-btn",
          ) as HTMLButtonElement;

          if (form && submitBtn) {
            form.addEventListener("submit", async (e) => {
              e.preventDefault();

              const originalText = submitBtn.innerText;
              submitBtn.innerText = "SENDING...";
              submitBtn.disabled = true;

              const formData = new FormData(form);

              try {
                const response = await fetch("/api/booking", {
                  method: "POST",
                  body: formData,
                });

                if (response.ok) {
                  alert("¡Reservation request sent successfully!");
                  form.reset();
                } else {
                  alert("Error sending request. Please try again.");
                }
              } catch (error) {
                console.error(error);
                alert("Connection error.");
              } finally {
                submitBtn.innerText = originalText;
                submitBtn.disabled = false;
              }
            });
          }
        </script>
      </div>
    </section>
    <!-- sección nueva -->
    <section
      class="w-full border-t border-b border-stone-200/60 py-16 md:py-24"
    >
      <div class="mx-auto max-w-7xl px-6 md:px-12">
        <header class="mb-12 max-w-2xl md:mb-16">
          <span
            class="text-primary mb-2 block text-xs font-bold uppercase tracking-wider md:text-sm"
          >
            {i18n.FAVORITIES.tag}
          </span>

          <h2
            class="font-serif text-3xl font-bold leading-tight text-stone-800 md:text-4xl lg:text-5xl"
          >
            {i18n.FAVORITIES.title}
          </h2>

          <p class="mt-4 font-light text-stone-500 md:text-lg">
            {i18n.FAVORITIES.description}
          </p>
        </header>
      </div>
      <div class="w-full mx-auto max-w-7xl lg:px-12">
        <div class="pl-6 pr-0 lg:px-0">
          <FavoritiesSeccion />
        </div>
      </div>
    </section>
    <section class="relative w-full overflow-hidden bg-[#fcfbf7]">
      <div class="grid min-h-[460px] grid-cols-1 md:grid-cols-[42%_1fr]">
        <div
          class="flex items-center justify-center px-6 py-10 md:pl-12 md:pr-6"
        >
          <div
            class="flex w-full max-w-full flex-col gap-[1.35rem] rounded-[20px] bg-white p-8 shadow-[0_8px_40px_rgba(0,0,0,0.09),0_2px_10px_rgba(0,0,0,0.04)] md:max-w-[310px]"
          >
            <h2
              class="font-serif text-[clamp(1.3rem,2vw,1.75rem)] font-bold leading-tight text-[#4e8782]"
            >
              {i18n.PUERTO_MORELOS.MAPS.title}
            </h2>
            <a
              href="https://maps.google.com/?q=Heriberto+Frías+Supermanzana+2+Manzana+14+L3+77580+Puerto+Morelos+QR"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 rounded-xl p-2 -mx-2 transition-colors duration-200 hover:bg-[rgba(27,92,87,0.04)] no-underline"
            >
              <span
                class="mt-0.5 flex h-[1.9rem] w-[1.9rem] shrink-0 items-center justify-center rounded-full bg-[rgba(211,66,50,0.12)] text-[#d34232] transition-transform duration-200 group-hover:scale-105"
              >
                <svg
                  class="h-[0.88rem] w-[0.88rem]"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                  ></path>
                  <circle cx="12" cy="9" r="2.5"></circle>
                </svg>
              </span>
              <div>
                <p
                  class="mb-[0.22rem] text-[0.6rem] font-bold tracking-[0.12em] uppercase text-[#1b5c57]"
                >
                  {i18n.PUERTO_MORELOS.MAPS.strategic_location_label}
                </p>
                <p
                  class="text-[0.76rem] font-medium leading-normal text-[#342e26] transition-colors duration-200 group-hover:text-[#1b5c57]"
                >
                  Heriberto Frías, Supermanzana 2, Manzana 14 L3, 77580 Puerto
                  Morelos, Q.R.
                </p>
              </div>
            </a>
            {/* Times row */}
            <div class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-[1.9rem] w-[1.9rem] shrink-0 items-center justify-center rounded-full bg-[rgba(196,128,36,0.12)] text-[#c07e22]"
              >
                <svg
                  class="h-[0.88rem] w-[0.88rem]"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <polyline points="12 7 12 12 15.5 15.5"></polyline>
                </svg>
              </span>
              <div class="flex-1">
                <p
                  class="mb-[0.22rem] text-[0.6rem] font-bold tracking-[0.12em] uppercase text-[#1b5c57]"
                >
                  {i18n.PUERTO_MORELOS.MAPS.travel_times_label}
                </p>
                <ul class="flex flex-col gap-[0.42rem] p-0 m-0 list-none">
                  {
                    i18n.PUERTO_MORELOS.MAPS.travel_times.map((item) => (
                      <li class="flex items-center justify-between gap-2">
                        <span class="text-[0.74rem] font-normal text-[#6b6055]">
                          {item.from}
                        </span>
                        <span class="text-[0.74rem] font-bold text-[#1b5c57] whitespace-nowrap">
                          {item.time}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
            {/* CTA BUTTON */}
            <a
              href="https://maps.google.com/?q=Heriberto+Frías+Supermanzana+2+Manzana+14+L3+77580+Puerto+Morelos+QR"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-0.5 block rounded-full bg-[#1b5c57] px-4 py-[0.82rem] text-center text-[0.7rem] font-semibold tracking-[0.04em] text-white no-underline shadow-[0_3px_12px_rgba(27,92,87,0.22)] transition-all duration-200 hover:-translate-y-px hover:bg-[#144844] hover:shadow-[0_6px_18px_rgba(27,92,87,0.30)]"
              id="find-us-maps-btn"
            >
              {i18n.PUERTO_MORELOS.MAPS.open_maps_button}
            </a>
          </div>
        </div>
        {/* RIGHT COLUMN — Map fills edge to edge */}
        <div class="relative min-h-[280px] overflow-hidden md:min-h-full">
          {/* Floating label "Mex on the Beach" */}
          <div
            class="pointer-events-none absolute top-1/2 left-1/2 z-10 inline-flex -translate-x-1/2 -translate-y-2/3 items-center gap-[0.3rem] rounded-full bg-white px-[0.85rem] py-[0.38rem] pl-[0.55rem] text-[0.7rem] font-bold text-[#1b5c57] whitespace-nowrap shadow-[0_4px_16px_rgba(0,0,0,0.15)] after:absolute after:bottom-[-6px] after:left-1/2 after:-translate-x-1/2 after:border-4 after:border-transparent after:border-top-white"
            aria-hidden="true"
          >
            <svg
              class="h-[0.75rem] w-[0.75rem] fill-[#1b5c57]"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"
              ></path>
            </svg>
            Mex on the Beach
          </div>
          <iframe
            id="find-us-map-iframe"
            title="Mex on the Beach Location Map"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-86.8795%2C20.8490%2C-86.8655%2C20.8590&layer=mapnik&marker=20.8541%2C-86.8726"
            class="absolute inset-0 h-full w-full border-none saturate-[0.65] brightness-[1.04] sepia-[0.12]"
          ></iframe>
          <div
            class="pointer-events-none absolute inset-0 z-0 hidden bg-gradient-to-r from-[#fcfbf7] via-[rgba(237,233,223,0.4)] to-transparent md:block md:w-[22%]"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </section>
    {/* 6. PARADISE CTA SECTION */}
    <section
      class="py-24 pb-40 bg-[#fcfbf7] relative overflow-hidden text-dark"
    >
      <div class="max-w-4xl mx-auto px-6 text-center relative z-10 space-y-6">
        <h2
          class="font-serif text-3xl md:text-4xl font-extrabold text-dark tracking-wider uppercase"
        >
          {i18n.PUERTO_MORELOS.ACTION.title}
        </h2>
        <p
          class="text-gray-500 font-light text-sm md:text-base max-w-xl mx-auto leading-relaxed"
        >
          {i18n.PUERTO_MORELOS.ACTION.description}
        </p>
        <div class="pt-4">
          <a
            href={bookingUrl}
            class="inline-block bg-primary hover:bg-primary-hover text-white py-4 px-10 rounded-full font-bold text-xs tracking-widest uppercase shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
          >
            {i18n.PUERTO_MORELOS.ACTION.book_button}
          </a>
        </div>
      </div>
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
        <svg
          viewBox="0 0 1440 40"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="w-full h-auto"
        >
          <path
            d="M0,20 C360,40 720,0 1080,20 C1260,30 1350,40 1440,30 L1440,40 L0,40 Z"
            fill="#ffffff"></path>
          <path
            d="M0,15 C360,35 720,-5 1080,15 C1260,25 1350,35 1440,25"
            stroke="var(--color-secondary)"
            stroke-width="2"
            fill="none"></path>
        </svg>
      </div>
    </section>
  </div>
</Layout>
