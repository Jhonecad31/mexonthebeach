        >
        </div>

        <script>
          const formContainer = document.getElementById(
            "booking-form-container",
          );
          const overlay = document.getElementById("booking-form-overlay");
          const openBtn = document.getElementById("open-form-btn");
          const closeBtn = document.getElementById("close-form-btn");
          const closeBar = document.getElementById("close-form-bar");

          const form = document.getElementById(
            "beach-club-booking-form",
          ) as HTMLFormElement;
          const submitBtn = document.getElementById(
            "submit-booking-btn",
          ) as HTMLButtonElement;

          // Funciones para Abrir / Cerrar en móvil
          const openMobileForm = () => {
            if (formContainer && overlay) {
              formContainer.classList.remove("translate-y-full");
              formContainer.classList.add("translate-y-0");
              overlay.classList.remove("hidden");
              // Pequeño timeout para que la transición de opacidad funcione suave
              setTimeout(() => overlay.classList.add("opacity-100"), 10);
              document.body.style.overflow = "hidden"; // Bloquea scroll del fondo
            }
          };

          const closeMobileForm = () => {
            if (formContainer && overlay) {
              formContainer.classList.remove("translate-y-0");
              formContainer.classList.add("translate-y-full");
              overlay.classList.remove("opacity-100");
              setTimeout(() => overlay.classList.add("hidden"), 30);
              document.body.style.overflow = ""; // Libera scroll
            }
          };

          // Event Listeners de la UI móvil
          openBtn?.addEventListener("click", openMobileForm);
          closeBtn?.addEventListener("click", closeMobileForm);
          closeBar?.addEventListener("click", closeMobileForm);
          overlay?.addEventListener("click", closeMobileForm);

          // Manejo de Submit del Formulario
          if (form && submitBtn) {
            form.addEventListener("submit", async (e) => {
              e.preventDefault();

              const originalText = submitBtn.innerText;
              submitBtn.innerText = "SENDING...";
              submitBtn.disabled = true;

              const formData = new FormData(form);

              try {
                const response = await fetch("/api/booking", {
                  method: "POST",
                  body: formData,
                });

                if (response.ok) {
                  alert("¡Reservation request sent successfully!");
                  form.reset();
                  closeMobileForm(); // Cierra el modal si se envió con éxito
                } else {
                  alert("Error sending request. Please try again.");
                }
              } catch (error) {
                console.error(error);
                alert("Connection error.");
              } finally {
                submitBtn.innerText = originalText;
                submitBtn.disabled = false;
              }
            });
          }
        </script>
      </div>
