---
import { useTranslations, type Lang } from "../i18n/utils";
import { getI18N } from "../i18n/index";
import { Check, ChevronRight, Info, X, Utensils, Camera } from "lucide-react";
import Layout from "@/layouts/BaseLayout.astro";
import FavoritiesFoodSeccion from "@/components/sections/FavoritesFood.astro";
import FavoritiesDrinksSeccion from "@/components/sections/FovoritesDrinks.astro";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const bookingUrl = lang === "en" ? "/#booking" : `/${lang}#booking`;
const carouselImages = [
  "/img-beach-club/mex-beach-club-lifestyle.webp",
  "/img-beach-club/mex-beach-club-relaxation.webp",
  "/img-beach-club/mex-beach-club-signature-drinks.webp",
];
import { Utensils, Camera, Info } from "lucide-react";
const menuCategories = [
  {
    title: i18n.MAKE_YOU_RESERVATION?.MENU?.STARTERS || "Entradas & Snacking",
    items: [
      {
        name: "Ceviche Mex on the Beach",
        price: "$320 MXN",
        desc: "Pesca del día marinada en cítricos locales, aguacate, habanero sutil y totopos artesanales.",
      },
      {
        name: "Tacos de Camarón Ensenada",
        price: "$280 MXN",
        desc: "Tres tacos en tortilla de maíz azul, camarón capeado, col morada y aderezo de chipotle.",
      },
    ],
  },
  {
    title: i18n.MAKE_YOU_RESERVATION?.MENU?.MAINS || "Platos Fuertes",
    items: [
      {
        name: "Pescado Tikin Xic",
        price: "$450 MXN",
        desc: "Clásico caribeño marinado en achiote, cocinado a las brasas y servido con arroz con coco.",
      },
      {
        name: "Hamburguesa Premium Beach",
        price: "$340 MXN",
        desc: "Corte selecto de res, queso cheddar fundido, tocino crujiente y papas trufadas.",
      },
    ],
  },
  {
    title: i18n.MAKE_YOU_RESERVATION?.MENU?.DRINKS || "Coctelería de Autor",
    items: [
      {
        name: "Mex Mojito",
        price: "$190 MXN",
        desc: "Ron blanco, hierbabuena fresca, azúcar de caña, infusión de maracuyá y un toque de agua mineral.",
      },
      {
        name: "Caribe Fling",
        price: "$210 MXN",
        desc: "Mezcal artesanal espadín, jugo de piña tatemada, jarabe de agave y escarcha de sal de gusano.",
      },
    ],
  },
];

const dishImages = [
  {
    src: "/img-beach-club/mex-beach-club-signature-drinks.webp",
    alt: "Coctelería Premium",
    label: "Mixología",
  },
  {
    src: "/img-beach-club/mex-beach-club-lifestyle.webp",
    alt: "Mariscos Frescos",
    label: "Mariscos",
  },
  {
    src: "/img-beach-club/mex-beach-club-relaxation.webp",
    alt: "Snacks junto al mar",
    label: "Snacks",
  },
];
---

<Layout>
  <div class="relative">
    {/* HERO SECTION */}
    <section
      class="relative h-[80vh] md:h-[90vh] w-full bg-[#FAF6EE] overflow-hidden flex items-center"
    >
      {/* CONTENEDOR DE IMAGEN Y CAPAS DE CONTRASTE */}
      <div
        class="absolute inset-0 z-0 overflow-hidden select-none pointer-events-none"
      >
        <img
          src="/img-beach-club/mex-beach-club-lifestyle.webp"
          alt="Puerto Morelos Aerial View"
          class="w-full h-full object-cover scale-105"
        />
        {/* Capa 1: Filtro ambiental sutil */}
        <div class="absolute inset-0 bg-black/15 z-10"></div>
        {
          /* Capa 2: Scrim premium de izquierda a derecha para proteger los textos */
        }
        <div
          class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/40 to-transparent z-10"
        >
        </div>
        {/* Capa 3: Soporte de contraste vertical exclusivo para móviles */}
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10 md:hidden"
        >
        </div>
        {/* Capa 4: Desvanecimiento limpio hacia el fondo crema de la web */}
        <div
          class="absolute inset-x-0 bottom-0 h-1/4 z-20"
          style={{
            background:
              "linear-gradient(to top, rgba(254, 251, 247, 1) 0%, rgba(254, 251, 247, 0) 100%)",
          }}
        >
        </div>
      </div>
      {/* CONTENIDO PRINCIPAL */}
      <div
        class="relative z-30 w-full max-w-6xl mx-auto px-6 md:px-12 flex flex-col items-start text-left mt-8 md:mt-0"
      >
        <div class="max-w-2xl space-y-5 md:space-y-6 animate-fade-in">
          <h1
            class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold text-white leading-[1.12] drop-shadow-[0_4px_12px_rgba(0,0,0,0.35)]"
          >
            {i18n.MAKE_YOU_RESERVATION.HERO.title}
          </h1>
          <p
            class="text-white/90 font-normal text-sm md:text-lg leading-relaxed drop-shadow-[0_2px_6px_rgba(0,0,0,0.3)] max-w-xl"
          >
            {i18n.MAKE_YOU_RESERVATION.HERO.description}
          </p>
          <div class="pt-3">
            <a
              href={bookingUrl}
              class="inline-block bg-primary hover:bg-primary-hover text-white py-4 px-10 rounded-full font-bold text-xs tracking-widest uppercase shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
            >
              {i18n.PUERTO_MORELOS.HERO.cta || "Explorar Experiencias"}
            </a>
          </div>
        </div>
      </div>
    </section>
    <section class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-12">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4">
        {
          [
            {
              label: "Access Type",
              value:
                i18n.FULL_DAY_BEACH_EXPERIENCE?.accessType ||
                "Beach Club Entry Only",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  {/* Icono de Ticket / Entrada */}
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-12h1.5c1.243 0 2.25 1.007 2.25 2.25v.515c0 .954.57 1.82 1.455 2.18l.382.156c.55.225.55 1.003 0 1.228l-.383.156c-.884.36-1.454 1.226-1.454 2.18v.516c0 1.243-1.007 2.25-2.25 2.25H7.5A2.25 2.25 0 0 1 5.25 17.25V6.75A2.25 2.25 0 0 1 7.5 4.5Z"
                  />
                </svg>
              ),
            },
            {
              label: "Duration",
              value:
                i18n.FULL_DAY_BEACH_EXPERIENCE?.duration || "Full Day Access",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  />
                </svg>
              ),
            },
            {
              label: "Family Friendly",
              value: i18n.FULL_DAY_BEACH_EXPERIENCE?.minAge || "For all ages",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  />
                </svg>
              ),
            },
            {
              label: "Schedules",
              value:
                i18n.FULL_DAY_BEACH_EXPERIENCE?.schedules ||
                "10:00 AM - 6:00 PM",
              icon: (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 md:w-6 md:h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"
                  />
                </svg>
              ),
            },
          ].map((item, idx) => (
            <div
              key={idx}
              class="bg-[#FAF6EE] p-3 md:p-4 rounded-xl flex flex-col items-center text-center justify-center border border-stone-100"
            >
              <div class="text-[#E77543] mb-1.5 md:mb-2">{item.icon}</div>
              <span class="text-[10px] md:text-xs font-semibold tracking-wider text-stone-800 uppercase block mb-0.5">
                {item.label}
              </span>
              <span class="text-[11px] md:text-xs font-light text-stone-500">
                {item.value}
              </span>
            </div>
          ))
        }
      </div>
    </section>
    <section
      class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-12 mt-12 md:mt-20"
    >
      <div
        class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 items-start -mt-15"
      >
        <div class="lg:col-span-2 space-y-8 md:space-y-12">
          <!-- Aqui empieza la información con acordeon -->
          <div class="divide-y divide-gray-200">
            <details class="group py-6" name="tour-info" open>
              <summary
                class="flex justify-between items-center cursor-pointer list-none select-none"
              >
                <span class="text-2xl md:text-3xl font-serif text-[#001524]">
                  {i18n.MAKE_YOU_RESERVATION.WHAT_INCLUDED.title}
                </span>
                <div
                  class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center group-open:rotate-180 transition-transform duration-300"
                >
                  <ChevronRight className="rotate-90 text-gray-500" size={20} />
                </div>
              </summary>
              <div class="mt-8">
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
                  {
                    i18n.MAKE_YOU_RESERVATION.WHAT_INCLUDED.includes.map(
                      (text) => (
                        <li class="flex items-start gap-3 text-base md:text-lg font-light text-gray-600">
                          <Check
                            className="text-[#006083] mt-1 shrink-0"
                            size={20}
                          />
                          <p>{text}</p>
                        </li>
                      ),
                    )
                  }
                  {
                    i18n.MAKE_YOU_RESERVATION.WHAT_INCLUDED.not_includes.map(
                      (text) => (
                        <li class="flex items-start gap-3 text-base md:text-lg font-light text-gray-600">
                          <X className="text-red-500 mt-1 shrink-0" size={20} />
                          <span>{text}</span>
                        </li>
                      ),
                    )
                  }
                </ul>
              </div>
            </details>
            {}
            <details class="group py-6" name="tour-info" open>
              <summary
                class="flex justify-between items-center cursor-pointer list-none select-none"
              >
                <span class="text-2xl md:text-3xl font-serif text-[#001524]">
                  {i18n.MAKE_YOU_RESERVATION.OVERVIEW.title}
                </span>
                <div
                  class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center group-open:rotate-180 transition-transform duration-300"
                >
                  <ChevronRight className="rotate-90 text-gray-500" size={20} />
                </div>
              </summary>
              <div
                class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed mt-5"
              >
                <p>{i18n.MAKE_YOU_RESERVATION.OVERVIEW.p1}</p>
                <p>{i18n.MAKE_YOU_RESERVATION.OVERVIEW.p2}</p>
                <p>{i18n.MAKE_YOU_RESERVATION.OVERVIEW.p3}</p>
                <p>{i18n.MAKE_YOU_RESERVATION.OVERVIEW.p4}</p>
              </div>
            </details>
            {}
            <details class="group py-6" name="tour-info" open>
              <summary
                class="flex justify-between items-center cursor-pointer list-none select-none"
              >
                <span class="text-2xl md:text-3xl font-serif text-[#001524]">
                  {i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE.title}
                </span>
                <div
                  class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center group-open:rotate-180 transition-transform duration-300"
                >
                  <ChevronRight className="rotate-90 text-gray-500" size={20} />
                </div>
              </summary>
              <div
                class="mb-16 bg-[#FAF6EE] border-l-4 border-[#E77543] p-6 md:p-8 rounded-r-2xl relative mt-10"
              >
                <p class="text-slate-800 font-medium">
                  {
                    i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE
                      .description
                  }
                </p>
              </div>
              <!-- Contenedor de Filas Informativas -->
              <div class="space-y-12">
                <!-- Bloque 2: Tu Día Junto al Mar -->
                <div
                  class="border-b border-slate-100 pb-8 md:grid md:grid-cols-3 md:gap-8 md:items-start"
                >
                  <div
                    class="md:col-span-1 mb-4 md:mb-0 flex items-center gap-3"
                  >
                    <!-- Icono de Olas / Relajación -->
                    <div
                      class="w-10 h-10 bg-[#FAF6EE] rounded-lg flex items-center justify-center flex-shrink-0"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6 text-[#E77543]"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2.25 12h19.5M2.25 9h19.5M2.25 15h19.5M2.25 18h19.5"
                        ></path>
                      </svg>
                    </div>
                    <h3 class="font-bold text-[#000000]/70 tracking-tight">
                      {
                        i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE
                          .titlep1
                      }
                    </h3>
                  </div>
                  <div class="md:col-span-2">
                    <div
                      class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed"
                    >
                      <p>
                        {i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE.p1}
                      </p>
                    </div>
                  </div>
                </div>
                <!-- Bloque 3: Naturaleza y Cultura Local -->
                <div
                  class="border-b border-slate-100 pb-8 md:grid md:grid-cols-3 md:gap-8 md:items-start"
                >
                  <div
                    class="md:col-span-1 mb-4 md:mb-0 flex items-center gap-3"
                  >
                    <!-- Icono de Palmera / Entorno Natural -->
                    <div
                      class="w-10 h-10 bg-[#FAF6EE] rounded-lg flex items-center justify-center flex-shrink-0"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6 text-[#E77543]"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 3v18M12 3a9 9 0 0 1 9 9h-9M12 3a9 9 0 0 0-9 9h9"
                        ></path>
                      </svg>
                    </div>
                    <h3 class="font-bold text-[#000000]/70 tracking-tight">
                      {
                        i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE
                          .titlep2
                      }
                    </h3>
                  </div>
                  <div class="md:col-span-2">
                    <div
                      class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed"
                    >
                      <p>
                        {i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE.p2}
                      </p>
                    </div>
                  </div>
                </div>
                <!-- Bloque 4: El Corazón de tu Viaje -->
                <div class="md:grid md:grid-cols-3 md:gap-8 md:items-start">
                  <div
                    class="md:col-span-1 mb-4 md:mb-0 flex items-center gap-3"
                  >
                    <!-- Icono de Mapa / Ubicación -->
                    <div
                      class="w-10 h-10 bg-[#FAF6EE] rounded-lg flex items-center justify-center flex-shrink-0"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6 text-[#E77543]"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                        ></path>
                      </svg>
                    </div>
                    <h3 class="font-bold text-[#000000]/70 tracking-tight">
                      {
                        i18n.FULL_DAY_BEACH_EXPERIENCE.LIVE_THE_EXPERIENCE
                          .titlep3
                      }
                    </h3>
                  </div>
                  <div class="md:col-span-2">
                    <div
                      class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed"
                    >
                      <p>
                        {i18n.MAKE_YOU_RESERVATION.LIVE_THE_EXPERIENCE.p3}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </details>
            {}
            <details
              class="group py-6 border-b border-gray-200"
              name="tour-info"
              open
            >
              <summary
                class="flex justify-between items-center cursor-pointer list-none select-none"
              >
                <span class="text-2xl md:text-3xl font-serif text-[#001524]">
                  {i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.title}
                </span>
                <div
                  class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center group-open:rotate-180 transition-transform duration-300"
                >
                  <ChevronRight className="rotate-90 text-gray-500" size={20} />
                </div>
              </summary>
              <div
                class="mb-16 bg-[#1E6B65]/10 border-l-4 border-[#4e8782] p-6 md:p-8 rounded-r-2xl relative mt-10"
              >
                <p class="text-slate-800 font-medium">
                  {i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.description}
                </p>
              </div>
              <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20"
              >
                <div class="space-y-6">
                  <div
                    class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed"
                  >
                    <p>
                      {i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.p1}
                    </p>
                    <p>
                      {i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.p2}
                    </p>
                  </div>
                </div>
                <div
                  class="grid grid-cols-2 gap-4 bg-slate-50 p-6 rounded-2xl border border-slate-100"
                >
                  <div
                    class="bg-white p-4 rounded-xl shadow-sm flex items-center gap-3"
                  >
                    <span class="text-xl">🏖️</span>
                    <span class="font-semibold text-slate-800 text-sm"
                      >{
                        i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.icons
                          .access
                      }</span
                    >
                  </div>
                  <div
                    class="bg-white p-4 rounded-xl shadow-sm flex items-center gap-3"
                  >
                    <span class="text-xl">🏊</span>
                    <span class="font-semibold text-slate-800 text-sm"
                      >{
                        i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.icons.pool
                      }</span
                    >
                  </div>
                  <div
                    class="bg-white p-4 rounded-xl shadow-sm flex items-center gap-3"
                  >
                    <span class="text-xl">🍹</span>
                    <span class="font-semibold text-slate-800 text-sm"
                      >{
                        i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.icons.food
                      }</span
                    >
                  </div>
                  <div
                    class="bg-white p-4 rounded-xl shadow-sm flex items-center gap-3"
                  >
                    <span class="text-xl">🥃</span>
                    <span class="font-semibold text-slate-800 text-sm"
                      >{
                        i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.icons
                          .tequila
                      }</span
                    >
                  </div>
                </div>
              </div>

              <!-- Bloque 3 & 4: Entorno y Cierre con un toque de fondo suave -->
              <div
                class="bg-[#4e8782]/10 rounded-3xl p-8 md:p-12 text-center max-w-4xl mx-auto"
              >
                <div
                  class="prose max-w-none text-stone-600 font-light space-y-4 md:space-y-6 text-sm md:text-base leading-relaxed"
                >
                  <h3 class="font-bold text-[#000000]/70 tracking-tight">
                    {i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.title_h3}
                  </h3>
                  <p>
                    {i18n.MAKE_YOU_RESERVATION.LOVE_SPENDING.p1_h3}
