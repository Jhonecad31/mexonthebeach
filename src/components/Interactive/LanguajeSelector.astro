---
import { getLangFromUrl, useTranslatedPath } from "../../i18n/utils";
interface Props {
  class?: string;
  isMobileDrawer?: boolean;
}
const { class: className = "", isMobileDrawer = false } = Astro.props;
const lang = getLangFromUrl(Astro.url) || "en";
const pathname = Astro.url.pathname;
const isMenuPage = pathname.includes("/the-mex");
const isContactPage = pathname.includes("/contacto") || pathname.includes("/contact") || pathname.includes("/contato");
const isPuertoMorelos = pathname.includes("/puerto-morelos");
let basePageKey = "/";
if (isMenuPage) basePageKey = "/the-mex";
if (isContactPage) basePageKey = "/contact";
if (isPuertoMorelos) basePageKey = "/puerto-morelos";

// 3. Generar las URLs limpias para cada idioma llamando dinámicamente al enrutador de Astro
const urlEn = useTranslatedPath("en")(basePageKey);
const urlEs = useTranslatedPath("es")(basePageKey);
const urlPt = useTranslatedPath("pt")(basePageKey);

const languages = [
  { code: "en", label: "English", flag: "https://flagcdn.com/w40/us.png", url: urlEn },
  { code: "es", label: "Español", flag: "https://flagcdn.com/w40/mx.png", url: urlEs },
  { code: "pt", label: "Português", flag: "https://flagcdn.com/w40/pt.png", url: urlPt }
];
---

{
  isMobileDrawer ? (
    /* Renderizado simple de botones circulares para el Drawer Móvil */
    <div class="flex justify-center gap-3">
      {languages.map((item) => (
        <a
          href={item.url}
          class={`flex items-center gap-2 px-4 py-2.5 rounded-full border text-xs font-bold transition-all duration-200 ${
            lang === item.code
              ? "bg-secondary/10 border-secondary text-secondary shadow-xs"
              : "bg-white border-gray-200 text-gray-650 hover:bg-gray-50"
          }`}
        >
          <img
            src={item.flag}
            alt={item.code.toUpperCase()}
            class="w-4 h-3 object-cover rounded-xs border border-slate-200/50"
          />
          {item.code.toUpperCase()}
        </a>
      ))}
    </div>
  ) : (
    /* Renderizado de Dropdown flotante elegante para Escritorio */
    <div class={`relative group ${className}`}>
      <button
        type="button"
        class="flex items-center text-sm font-semibold text-dark/70 hover:text-[#4e8782] transition-colors cursor-pointer gap-2 focus:outline-none"
      >
        <svg
          class="h-5 w-5 text-gray-400 group-hover:text-[#4e8782] transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          <path d="M2 12h20" />
        </svg>
        <span class="tracking-wide uppercase font-bold">{lang}</span>
        <svg
          class="h-4 w-4 text-gray-400 group-hover:text-[#4e8782] transition-colors"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
      </button>

      <!-- Dropdown Menu -->
      <div
        class="absolute right-0 mt-2 w-36 bg-[#fcfbf7] rounded-xl shadow-lg border border-gray-100 py-1.5 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
      >
        {languages.map((item) => (
          <a
            href={item.url}
            class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${
              lang === item.code
                ? "text-[#4e8782] font-bold bg-secondary/5"
                : "text-dark/80 hover:bg-sand-light"
            }`}
          >
            <img
              src={item.flag}
              alt={item.code.toUpperCase()}
              class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
            />
            {item.label}
            {lang === item.code && <span class="ml-auto inline-flex size-1.5 rounded-full bg-[#4e8782]" />}
          </a>
        ))}
      </div>
    </div>
  )
}