---
import { getLangFromUrl, useTranslatedPath } from "../../i18n/utils";
interface Props {
  class?: string;
  isMobileDrawer?: boolean;
}
const { class: className = "", isMobileDrawer = false } = Astro.props;
const lang = getLangFromUrl(Astro.url) || "en";
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(new RegExp(`^/${lang}(/|$)`), "/") || "/";
const urlEn = useTranslatedPath("en")(cleanPath);
const urlEs = useTranslatedPath("es")(cleanPath);
const urlPt = useTranslatedPath("pt")(cleanPath);

const languages = [
  {
    code: "en",
    label: "English",
    flag: "https://flagcdn.com/w40/us.png",
    url: urlEn,
  },
  {
    code: "es",
    label: "Español",
    flag: "https://flagcdn.com/w40/mx.png",
    url: urlEs,
  },
  {
    code: "pt",
    label: "Português",
    flag: "https://flagcdn.com/w40/pt.png",
    url: urlPt,
  },
];
---

{
  isMobileDrawer ? (
    <div class="flex justify-center gap-3">
      {languages.map((item) => (
        <a
          href={item.url}
          class={`flex items-center gap-2 px-4 py-2.5 rounded-full border text-xs font-bold transition-all duration-200 ${
            lang === item.code
              ? "bg-secondary/10 border-secondary text-secondary shadow-xs"
              : "bg-white border-gray-200 text-gray-650 hover:bg-gray-50"
          }`}
        >
          <img
            src={item.flag}
            alt={item.code.toUpperCase()}
            class="w-4 h-3 object-cover rounded-xs border border-slate-200/50"
          />
          {item.code.toUpperCase()}
        </a>
      ))}
    </div>
  ) : (
    <div class={`relative lang-dropdown-container ${className}`}>
      <button
        type="button"
        class="lang-dropdown-btn flex items-center text-sm font-semibold transition-colors duration-300 cursor-pointer gap-2 focus:outline-none text-white/80 hover:text-[#4e8782] group-data-[scrolled=true]/header:text-dark/80 group-data-[scrolled=true]/header:hover:text-[#4e8782]"
        aria-expanded="false"
        aria-label="Select Language"
      >
        <svg
          class="h-5 w-5 transition-colors duration-300 text-white/80 group-hover:text-[#4e8782] group-data-[scrolled=true]/header:text-dark/70 group-data-[scrolled=true]/header:group-hover:text-[#4e8782]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          <path d="M2 12h20" />
        </svg>
        <span class="tracking-wide uppercase font-bold">{lang}</span>
        <svg
          class="h-4 w-4 transition-colors duration-300 text-white/80 group-hover:text-[#4e8782] group-data-[scrolled=true]/header:text-dark/70 group-data-[scrolled=true]/header:group-hover:text-[#4e8782]"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
      <div class="lang-dropdown-menu absolute right-0 mt-2 w-36 bg-[#fcfbf7] rounded-xl shadow-lg border border-gray-100 py-1.5 z-50 opacity-0 invisible transition-all duration-200">
        {languages.map((item) => (
          <a
            href={item.url}
            class={`flex items-center gap-2.5 px-4 py-2 text-sm text-left transition-colors ${
              lang === item.code
                ? "text-[#4e8782] font-bold bg-secondary/5"
                : "text-dark/80 hover:bg-sand-light"
            }`}
          >
            <img
              src={item.flag}
              alt={item.code.toUpperCase()}
              class="w-[20px] h-[14px] object-cover rounded-sm shadow-sm border border-slate-200/80"
            />
            {item.label}
            {lang === item.code && (
              <span class="ml-auto inline-flex size-1.5 rounded-full bg-[#4e8782]" />
            )}
          </a>
        ))}
      </div>
    </div>
  )
}
<script>
  function setupLangDropdown() {
    const containers = document.querySelectorAll(".lang-dropdown-container");
    containers.forEach((container) => {
      const btn = container.querySelector(".lang-dropdown-btn");
      const menu = container.querySelector(".lang-dropdown-menu");
      if (!btn || !menu) return;
      const toggleMenu = (e: Event) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains("opacity-100");
        document.querySelectorAll(".lang-dropdown-menu").forEach((m) => {
          m.classList.remove("opacity-100", "visible");
          m.classList.add("opacity-0", "invisible");
        });
        if (!isOpen) {
          menu.classList.remove("opacity-0", "invisible");
          menu.classList.add("opacity-100", "visible");
          btn.setAttribute("aria-expanded", "true");
        } else {
          btn.setAttribute("aria-expanded", "false");
        }
      };
      container.addEventListener("mouseenter", () => {
        if (window.innerWidth >= 768) {
          menu.classList.remove("opacity-0", "invisible");
          menu.classList.add("opacity-100", "visible");
        }
      });
      container.addEventListener("mouseleave", () => {
        if (window.innerWidth >= 768) {
          menu.classList.remove("opacity-100", "visible");
          menu.classList.add("opacity-0", "invisible");
        }
      });
      btn.addEventListener("click", toggleMenu);
    });
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest(".lang-dropdown-container")) {
        document.querySelectorAll(".lang-dropdown-menu").forEach((m) => {
          m.classList.remove("opacity-100", "visible");
          m.classList.add("opacity-0", "invisible");
        });
      }
    });
  }
  setupLangDropdown();
  document.addEventListener("astro:page-load", setupLangDropdown);
</script>
