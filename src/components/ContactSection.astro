---
import { getI18N } from "../i18n/index";
import Layout from "@/layouts/BaseLayout.astro";
import FormContactReact from "@/components/sections/FormContact";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
const lang = getLangFromUrl(Astro.url) || "en";
const translatePath = useTranslatedPath(lang);
interface Props {
  lang?: string;
}
---
<Layout>
  <div class="bg-white mt-20">
    <!-- CONTACT SECTION -->
    <section class="py-12 md:py-16 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          
          <div class="lg:col-span-6 space-y-6">
            <div class="space-y-3">
              <h2 class="font-serif text-2xl md:text-3xl font-extrabold text-[#4e8782] tracking-wider uppercase">
                {i18n.CONTACT.title}
              </h2>
              <div class="prose max-w-none text-stone-600 font-light text-sm md:text-base leading-relaxed">
                <p>
                  {i18n.CONTACT.subtitle}
                </p>
              </div>
            </div>
            <div class="space-y-4 pt-2">
              <!-- Item 1: Address -->
              <div class="flex items-center gap-4">
                <div class="w-11 h-11 bg-secondary/10 text-[#4e8782] rounded-full flex items-center justify-center flex-shrink-0 shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-[10px] text-primary tracking-widest uppercase">{i18n.CONTACT.INFO.address.title}</h4>
                  <p class="text-xs text-zinc-700 font-semibold mt-0.5">{i18n.CONTACT.INFO.address.value}</p>
                </div>
              </div>
              <!-- Item 2: Phone -->
              <div class="flex items-center gap-4">
                <div class="w-11 h-11 bg-secondary/10 text-[#4e8782] rounded-full flex items-center justify-center flex-shrink-0 shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-[10px] text-primary tracking-widest uppercase">{i18n.CONTACT.INFO.phone.title}</h4>
                  <p class="text-xs text-zinc-700 font-semibold mt-0.5">{i18n.CONTACT.INFO.phone.value}</p>
                </div>
              </div>
              <!-- Item 3: Email -->
              <div class="flex items-center gap-4">
                <div class="w-11 h-11 bg-secondary/10 text-[#4e8782] rounded-full flex items-center justify-center flex-shrink-0 shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-[10px] text-primary tracking-widest uppercase">{i18n.CONTACT.INFO.email.title}</h4>
                  <p class="text-xs text-zinc-700 font-semibold mt-0.5">{i18n.CONTACT.INFO.email.value}</p>
                </div>
              </div>
            </div>
            <!-- Social share links -->
            <div class="pt-4">
              <h5 class="text-[10px] font-bold text-zinc-400 tracking-widest uppercase mb-2">FOLLOW</h5>
              <div class="flex space-x-3">
                <a href="https://www.facebook.com/mexonthebeachmx" aria-label="Facebook" class="w-10 h-10 rounded-full border border-primary/20 hover:border-primary bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white hover:shadow-xs transition-all duration-300">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9 8H7v3h2v9h3v-9h3.6l.4-3H12V6c0-.5.5-1 1-1h3V2h-3c-2.5 0-4 1.5-4 4v2z"/>
                  </svg>
                </a>
                <a href="https://www.instagram.com/mexonthebeachmx/" aria-label="Instagram" class="w-10 h-10 rounded-full border border-primary/20 hover:border-primary bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white hover:shadow-xs transition-all duration-300">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <!-- COMPONENTE HIDRATADO DE REACT -->
          <div class="lg:col-span-6 w-full flex justify-center lg:justify-end">
            <FormContactReact i18n={i18n} client:load />
          </div>
        </div>
      </div>
    </section>
    <!-- MAP SECTION -->
    <section class="relative w-full overflow-hidden bg-[#fcfbf7] border-t border-stone-100">
      <div class="grid min-h-[400px] grid-cols-1 md:grid-cols-[40%_1fr]">
        <!-- LEFT COLUMN -->
        <div class="flex items-center justify-center px-6 py-12 md:py-16 md:pl-12 md:pr-6">
          <div class="flex w-full max-w-full flex-col gap-[1.2rem] rounded-[20px] bg-white p-6 md:p-8 shadow-[0_8px_30px_rgba(0,0,0,0.06)] md:max-w-[310px]">
            <h2 class="font-serif text-[clamp(1.25rem,2vw,1.6rem)] font-bold leading-tight text-[#4e8782]">
              {i18n.PUERTO_MORELOS.MAPS.title}
            </h2>
            
            <a
              href="https://maps.google.com/?q=Heriberto+Frías+Supermanzana+2+Manzana+14+L3+77580+Puerto+Morelos+QR"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 rounded-xl p-2 -mx-2 transition-colors duration-200 hover:bg-[rgba(27,92,87,0.04)] no-underline"
            >
              <span class="mt-0.5 flex h-[1.8rem] w-[1.8rem] shrink-0 items-center justify-center rounded-full bg-[rgba(211,66,50,0.12)] text-[#d34232] transition-transform duration-200 group-hover:scale-105">
                <svg class="h-[0.85rem] w-[0.85rem]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"></path>
                  <circle cx="12" cy="9" r="2.5"></circle>
                </svg>
              </span>
              <div>
                <p class="mb-[0.2rem] text-[0.6rem] font-bold tracking-[0.12em] uppercase text-[#1b5c57]">
                  {i18n.PUERTO_MORELOS.MAPS.strategic_location_label}
                </p>
                <p class="text-[0.74rem] font-medium leading-normal text-[#342e26] transition-colors duration-200 group-hover:text-[#1b5c57]">
                  Heriberto Frías, Supermanzana 2, Manzana 14 L3, 77580 Puerto Morelos, Q.R.
                </p>
              </div>
            </a>

            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-[1.8rem] w-[1.8rem] shrink-0 items-center justify-center rounded-full bg-[rgba(196,128,36,0.12)] text-[#c07e22]">
                <svg class="h-[0.85rem] w-[0.85rem]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <polyline points="12 7 12 12 15.5 15.5"></polyline>
                </svg>
              </span>
              <div class="flex-1">
                <p class="mb-[0.2rem] text-[0.6rem] font-bold tracking-[0.12em] uppercase text-[#1b5c57]">
                  {i18n.PUERTO_MORELOS.MAPS.travel_times_label}
                </p>
                <ul class="flex flex-col gap-[0.35rem] p-0 m-0 list-none">
                  {
                    i18n.PUERTO_MORELOS.MAPS.travel_times.map((item) => (
                      <li class="flex items-center justify-between gap-2">
                        <span class="text-[0.72rem] font-normal text-[#6b6055]">
                          {item.from}
                        </span>
                        <span class="text-[0.72rem] font-bold text-[#1b5c57] whitespace-nowrap">
                          {item.time}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
            <a
              href="https://maps.google.com/?q=Heriberto+Frías+Supermanzana+2+Manzana+14+L3+77580+Puerto+Morelos+QR"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 block rounded-full bg-[#1b5c57] px-4 py-[0.75rem] text-center text-[0.7rem] font-semibold tracking-[0.04em] text-white no-underline shadow-[0_3px_10px_rgba(27,92,87,0.15)] transition-all duration-200 hover:-translate-y-px hover:bg-[#144844] hover:shadow-[0_5px_15px_rgba(27,92,87,0.25)]"
              id="find-us-maps-btn"
            >
              {i18n.PUERTO_MORELOS.MAPS.open_maps_button}
            </a>
          </div>
        </div>
        
        <!-- RIGHT COLUMN -->
        <div class="relative min-h-[320px] overflow-hidden md:min-h-full">
          <div
            class="pointer-events-none absolute top-1/2 left-1/2 z-10 inline-flex -translate-x-1/2 -translate-y-2/3 items-center gap-[0.3rem] rounded-full bg-white px-[0.85rem] py-[0.38rem] pl-[0.55rem] text-[0.7rem] font-bold text-[#1b5c57] whitespace-nowrap shadow-[0_4px_16px_rgba(0,0,0,0.15)]"
            aria-hidden="true"
          >
            <svg class="h-[0.75rem] w-[0.75rem] fill-[#1b5c57]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"></path>
            </svg>
            Mex on the Beach
          </div>
          <iframe
            id="find-us-map-iframe"
            title="Mex on the Beach Location Map"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-86.8795%2C20.8490%2C-86.8655%2C20.8590&layer=mapnik&marker=20.8541%2C-86.8726"
            class="absolute inset-0 h-full w-full border-none saturate-[0.65] brightness-[1.04] sepia-[0.12]"
          ></iframe>
          <div
            class="pointer-events-none absolute inset-0 z-0 hidden bg-gradient-to-r from-[#fcfbf7] via-[rgba(237,233,223,0.4)] to-transparent md:block md:w-[22%]"
            aria-hidden="true"
          ></div>
        </div>
      </div>
    </section>

    <!-- PARADISE CTA SECTION -->
    <section class="py-16 md:py-20 bg-[#fcfbf7] relative overflow-hidden text-dark">
      <div class="max-w-4xl mx-auto px-6 text-center relative z-10 space-y-5">
        <h2 class="font-serif text-2xl md:text-3xl font-extrabold text-dark tracking-wider uppercase">
          {i18n.PUERTO_MORELOS.ACTION.title}
        </h2>
        <p class="text-gray-500 font-light text-sm md:text-base max-w-xl mx-auto leading-relaxed">
          {i18n.PUERTO_MORELOS.ACTION.description}
        </p>
        <div class="pt-2">
          <a
            href={translatePath("/make-reservation")}
            class="inline-block bg-primary hover:bg-primary-hover text-white py-3.5 px-8 rounded-full font-bold text-xs tracking-widest uppercase shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
          >
            {i18n.PUERTO_MORELOS.ACTION.book_button}
          </a>
        </div>
      </div>
      
      <!-- Decorative separating line -->
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
        <svg viewBox="0 0 1440 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,20 C360,40 720,0 1080,20 C1260,30 1350,40 1440,30 L1440,40 L0,40 Z" fill="#ffffff"></path>
          <path d="M0,15 C360,35 720,-5 1080,15 C1260,25 1350,35 1440,25" stroke="var(--color-secondary)" stroke-width="2" fill="none"></path>
        </svg>
      </div>
    </section>
  </div>
</Layout>