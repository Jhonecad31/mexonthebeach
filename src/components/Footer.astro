---
import logoMex from "../assets/logos/logo_notb.svg";
import { useTranslations } from "../i18n/utils";
import { getI18N } from "../i18n/index";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<footer id="footer" class="bg-[#fcfbf7] text-dark/70 py-16 relative mt-12 md:mt-20">
  {/* LÍNEA DECORATIVA SUPERIOR */}
  <div class="w-full absolute -top-[39px] left-0 right-0 overflow-hidden leading-none pointer-events-none z-10">
    <svg
      viewBox="0 0 1440 40"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto block"
      preserveAspectRatio="none"
    >
      <path
        d="M0,20 C360,40 720,0 1080,20 C1260,30 1350,40 1440,30 L1440,40 L0,40 Z"
        fill="#ffffff"
      ></path>
      <path
        d="M0,15 C360,35 720,-5 1080,15 C1260,25 1350,35 1440,25"
        stroke="var(--color-secondary)"
        stroke-width="2"
        fill="none"
      ></path>
    </svg>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">
      <a
        href={lang === "es" ? "/es" : "/"}
        class="flex items-center justify-center mb-8 group"
      >
        <img
          src={logoMex.src}
          alt="Mex on the Beach Logo"
          class="h-20 w-auto object-contain group-hover:scale-105 transition-transform duration-300"
        />
      </a>
      <div
        class="flex flex-wrap justify-center gap-6 md:gap-12 mb-8 text-sm font-medium tracking-wide text-dark/80"
      >
        <a href="#privacy" class="hover:text-primary transition-colors"
          >{i18n.FOOTER.privacy}</a
        >
        <a href="#terms" class="hover:text-primary transition-colors"
          >{i18n.FOOTER.terms}</a
        >
        <a
          href={lang === "es" ? "/es/contacto" : "/contact"}
          class="hover:text-primary transition-colors">{i18n.FOOTER.contact}</a
        >
      </div>
      <div class="flex space-x-6 mb-10">
        <!-- Facebook -->
        <a
          href="https://www.facebook.com/mexonthebeachmx"
          aria-label="Facebook"
          class="w-12 h-12 rounded-full border border-primary/20 hover:border-primary bg-[#fcfbf7] flex items-center justify-center text-primary hover:bg-primary hover:text-[#fcfbf7] hover:shadow-md transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M9 8H7v3h2v9h3v-9h3.6l.4-3H12V6c0-.5.5-1 1-1h3V2h-3c-2.5 0-4 1.5-4 4v2z"
            ></path>
          </svg>
        </a>
        <!-- Instagram -->
        <a
          href="https://www.instagram.com/mexonthebeachmx/"
          aria-label="Instagram"
          class="w-12 h-12 rounded-full border border-primary/20 hover:border-primary bg-[#fcfbf7] flex items-center justify-center text-primary hover:bg-primary hover:text-[#fcfbf7] hover:shadow-md transition-all duration-300"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>
      <div class="text-xs text-gray-400 font-light tracking-wide">
        <p>{i18n.FOOTER.copyright}</p>
      </div>
    </div>
  </div>
</footer>