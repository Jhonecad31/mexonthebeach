---
import logoMex from '../assets/logos/logo-mex.svg';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<footer id="footer" class="bg-white text-dark/70 py-16 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">
      <!-- Logo -->
      <a href={lang === 'es' ? '/es' : '/'} class="flex items-center justify-center mb-8 group">
        <img 
          src={logoMex.src} 
          alt="Mex on the Beach Logo" 
          class="h-20 w-auto object-contain group-hover:scale-105 transition-transform duration-300" 
        />
      </a>
      <!-- Footer Menu Links -->
      <div class="flex flex-wrap justify-center gap-6 md:gap-12 mb-8 text-sm font-medium tracking-wide text-dark/80">
        <a href="#privacy" class="hover:text-primary transition-colors">{t('footer.privacy')}</a>
        <a href="#terms" class="hover:text-primary transition-colors">{t('footer.terms')}</a>
        <a href={lang === 'es' ? '/es/contacto' : '/contact'} class="hover:text-primary transition-colors">{t('footer.contact')}</a>
      </div>
      <!-- Social Icons matching prototype mockup with brand colors -->
      <div class="flex space-x-6 mb-10">
        <!-- Facebook -->
        <a href="#facebook" aria-label="Facebook" class="w-12 h-12 rounded-full border border-primary/20 hover:border-primary bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white hover:shadow-md transition-all duration-300">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9 8H7v3h2v9h3v-9h3.6l.4-3H12V6c0-.5.5-1 1-1h3V2h-3c-2.5 0-4 1.5-4 4v2z"/>
          </svg>
        </a>
        <!-- Instagram -->
        <a href="#instagram" aria-label="Instagram" class="w-12 h-12 rounded-full border border-primary/20 hover:border-primary bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white hover:shadow-md transition-all duration-300">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <!-- TikTok -->
        <a href="#tiktok" aria-label="TikTok" class="w-12 h-12 rounded-full border border-primary/20 hover:border-primary bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white hover:shadow-md transition-all duration-300">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.02 1.63 4.19 1.13 1.25 2.72 2.01 4.39 2.19v3.8c-1.89-.01-3.76-.58-5.32-1.68-.13-.09-.27-.2-.43-.32v6.62c.04 1.63-.44 3.29-1.46 4.54-1.67 2.13-4.52 3.04-7.14 2.33-2.62-.71-4.71-2.92-5.18-5.6-.61-3.51 1.48-6.99 4.96-8.03.88-.26 1.8-.35 2.71-.24v3.91c-.9-.23-1.88-.04-2.6.53-.88.69-1.22 1.85-.92 2.92.3 1.08 1.29 1.89 2.41 1.95 1.59.09 3.02-1.07 3.12-2.66.02-1.01 0-2.02.01-3.03V0z"/>
          </svg>
        </a>
      </div>
      <!-- Copyright Section matching screenshot -->
      <div class="text-xs text-gray-400 font-light tracking-wide">
        <p>{t('footer.copyright')}</p>
      </div>
    </div>
  </div>
</footer>
