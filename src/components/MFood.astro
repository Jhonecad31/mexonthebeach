---
import Layout from '../layouts/BaseLayout.astro';

const menuImages = [
  '/menu-folder/menu-food1.webp',
  '/menu-folder/menu-foodp2.webp',
  '/menu-folder/menu-foodp3.webp',
  '/menu-folder/menu-foodp4.webp',
];

const sections = [
  {
    title:"THIS IS PUERTO MORELOS", 
    actionText:"VIEW PUERTO MORELOS", 
    link:"/menu",
    bgImage:"/img-puerto-morelos/Puerto-Morelos-aerial.webp", 
    alt: "Menú de alimentos y bebidas del beach club"
  },
  {
    title: "FIND US",
    actionText: "OUR LOCATION",
    link: "/location",
    bgImage: "/img-food/beach-club-in-puerto-morelos.jpeg", 
    alt: "Instalaciones de Mex on the Beach"
  }
];

const labels = {
  heroTag: "The Cocktail Club",
  heroTitle: "Our Menus",
  breadcrumb: "The Mex-Caribbean Palate / Menus",
  sectionTitle: "Explore our menus",
  sectionDesc: "Rooted in the Puerto Morelos waterfront setting, Mex On The Beach places mixology and gastronomy at its core, with creations crafted live using premium spirits, fresh local ingredients, and refined techniques.",
};
---
<Layout title="Menu - Mex On The Beach">
  <div class="bg-[#fcfbf7] min-h-screen text-[#1a1a1a]">
    
    {/* HERO SECTION */}
    <section 
      class="relative h-[40vh] flex flex-col justify-center items-center text-white bg-cover bg-center"
      style="background-image: url('/img-beach-club/mex-beach-drinks.webp');"
    >
      <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
      
      <div class="relative z-10 text-center">
        <span class="text-xs tracking-[0.2em] uppercase opacity-90 block mb-2">{labels.heroTag}</span>
        <h1 class="text-4xl md:text-5xl font-serif tracking-wide uppercase">{labels.heroTitle}</h1>
      </div>
    </section>

    {/* BREADCRUMB */}
    <div class="bg-[#f3ede4] py-3 text-center text-[10px] tracking-[0.15em] uppercase text-gray-600 border-b border-gray-200">
      {labels.breadcrumb}
    </div>

    {/* INTRO SECTION */}
    <section class="max-w-3xl mx-auto text-center px-6 py-16">
      <h2 class="text-2xl md:text-3xl font-serif mb-4 text-[#2c4e4b]">{labels.sectionTitle}</h2>
      <p class="text-xs md:text-sm text-gray-600 leading-relaxed max-w-2xl mx-auto font-light">
        {labels.sectionDesc}
      </p>
    </section>

    {/* MENU IMAGES GRID (Cambio clave aquí) */}
    <main class="max-w-6xl mx-auto px-4 pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {menuImages.map((src, index) => (
          <div class="bg-white shadow-md hover:shadow-xl border border-black/5 overflow-hidden rounded-sm transition-shadow duration-300">
            <img 
              src={src} 
              alt={`Menu page ${index + 1}`} 
              class="w-full h-auto block select-none"
              loading={index < 2 ? "eager" : "lazy"} 
              decoding="async"
            />
          </div>
        ))}
      </div>
    </main>

    {/* BOTTOM SECTIONS */}
    <section class="bg-[#fcf9f5] px-4 py-16 md:px-8 lg:px-16 border-t border-gray-100">
      <div class="mx-auto max-w-6xl grid grid-cols-1 md:grid-cols-2 gap-6">
        {sections.map((section) => (
          <a 
            href={section.link}
            class="group relative block aspect-[4/3] w-full overflow-hidden bg-zinc-900 shadow-sm transition-all duration-300"
          >
            {/* Imagen de fondo con zoom suave en hover */}
            {section.bgImage && (
              <img 
                src={section.bgImage} 
                alt={section.alt}
                class="absolute inset-0 h-full w-full object-cover opacity-70 transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
            )}

            {/* Capa de oscurecimiento (Overlay) */}
            <div class="absolute inset-0 bg-black/30 transition-colors duration-300 group-hover:bg-black/50" />
            {/* Contenido de Texto */}
            <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-10 text-white">
              <h3 class="font-serif text-2xl tracking-wide md:text-3xl lg:text-4xl mb-2">
                {section.title}
              </h3>
              <div class="inline-flex flex-col items-start">
                <span class="text-xs font-medium tracking-widest uppercase">
                  {section.actionText}
                </span>
                {/* Línea decorativa inferior (Underline animation) */}
                <span class="h-[1.5px] w-0 bg-white mt-1 transition-all duration-300 group-hover:w-full origin-left" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>