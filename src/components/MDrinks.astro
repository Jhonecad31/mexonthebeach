---
import Layout from '../layouts/BaseLayout.astro';

// 1. Definimos las rutas de las imágenes que tienes en tu carpeta public/menu-folder/
const menuImages = [
  '/menu-folder/menu-drinksp1.webp',
  '/menu-folder/menu-drinksp2.webp',
];

const sections = [
  {
    title: "OUR MENUS",
    actionText: "VIEW MENUS",
    link: "/menu",
    bgImage: "https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=800&auto=format&fit=crop", // Reemplazar por foto de platillos
    alt: "Menú de alimentos y bebidas del beach club"
  },
  {
    title: "FIND US",
    actionText: "OUR LOCATION",
    link: "/location",
    bgImage: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=800&auto=format&fit=crop", // Reemplazar por foto de las instalaciones en Puerto Morelos / Cancún
    alt: "Instalaciones de Mex on the Beach"
  }
];

const labels = {
  heroTag: "The Cocktail Club",
  heroTitle: "Our Menus",
  breadcrumb: "Mex on the beach home / Menus",
  sectionTitle: "Explore our menus",
  sectionDesc: "Rooted in the Puerto Morelos waterfront setting, Mex On The Beach places mixology and gastronomy at its core, with creations crafted live using premium spirits, fresh local ingredients, and refined techniques.",
};
---
<Layout title="Menu - Mex On The Beach">
  <div class="bg-[#fcfbf7] min-h-screen text-[#1a1a1a]">
    
    <section 
      class="relative h-[40vh] flex flex-col justify-center items-center text-white bg-cover bg-center"
      style="background-image: url('/img-drinks/mex-beach-drinks-coct.webp');"
    >
      <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
      
      <div class="relative z-10 text-center">
        <span class="text-xs tracking-[0.2em] uppercase opacity-90 block mb-2">{labels.heroTag}</span>
        <h1 class="text-4xl md:text-5xl font-serif tracking-wide uppercase">{labels.heroTitle}</h1>
      </div>
    </section>

    <div class="bg-[#f3ede4] py-3 text-center text-[10px] tracking-[0.15em] uppercase text-gray-600 border-b border-gray-200">
      {labels.breadcrumb}
    </div>

    <section class="max-w-3xl mx-auto text-center px-6 py-16">
      <h2 class="text-2xl md:text-3xl font-serif mb-4 text-[#2c4e4b]">{labels.sectionTitle}</h2>
      <p class="text-xs md:text-sm text-gray-600 leading-relaxed max-w-2xl mx-auto font-light">
        {labels.sectionDesc}
      </p>
    </section>
    <main class="max-w-3xl mx-auto px-4 pb-24 flex flex-col gap-y-6">
      {menuImages.map((src, index) => (
        <div class="shadow-md md:shadow-xl border border-black/5 overflow-hidden rounded-sm">
          <img 
            src={src} 
            alt={`Menu page ${index + 1}`} 
            class="w-full h-auto block select-none"
            loading={index === 0 ? "eager" : "lazy"} 
            decoding="async"
          />
        </div>
      ))}
    </main>
    <section class="bg-[#fcf9f5] px-4 py-16 md:px-8 lg:px-16">
  <div class="mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-6">
    {sections.map((section) => (
      <a 
        href={section.link}
        class="group relative block aspect-[4/3] w-full overflow-hidden bg-zinc-900 shadow-sm transition-all duration-300 walk-fade"
      >
        {/* Imagen de fondo con zoom suave en hover */}
        <img 
          src={section.bgImage} 
          alt={section.alt}
          class="absolute inset-0 h-full w-full object-cover opacity-70 transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
        />

        {/* Capa de oscurecimiento (Overlay) que se intensifica en hover */}
        <div class="absolute inset-0 bg-black/30 transition-colors duration-300 group-hover:bg-black/50" />

        {/* Contenido de Texto */}
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-10 text-white">
          <h3 class="font-serif text-3xl tracking-wide md:text-4xl lg:text-5xl mb-2">
            {section.title}
          </h3>
          <div class="inline-flex flex-col items-start">
            <span class="text-xs font-medium tracking-widest uppercase md:text-sm">
              {section.actionText}
            </span>
            {/* Línea decorativa inferior (Underline) */}
            <span class="h-[1.5px] w-full bg-white mt-1 transform scale-x-100 transition-transform duration-300 origin-left" />
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
  </div>
</Layout>