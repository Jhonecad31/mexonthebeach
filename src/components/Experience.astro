---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<section id="experience" class="pt-24 pb-40 bg-[#fcfbf7] relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-6 relative flex justify-center py-6">
        <div class="absolute w-[360px] h-[420px] bg-secondary/10 rounded-[120px_240px_120px_240px] blur-3xl -z-10"></div>
        <div class="w-[320px] h-[400px] sm:w-[350px] sm:h-[440px] overflow-hidden rounded-[120px_240px_120px_240px] shadow-2xl relative z-10">
          <img 
            src="img-food/food-beach-club-in-puerto-morelos.webp" 
            alt="Delicious food on the beach" 
            class="w-full h-full object-cover"
          />
        </div>    
        <div class="w-36 h-36 sm:w-40 sm:h-40 rounded-full overflow-hidden absolute bottom-[10px] right-2 sm:right-6 z-20 border-[6px] border-white shadow-xl">
          <img 
            src="img-food/food-in-the-beach.webp" 
            alt="Ocean water beach thumbnail" 
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div class="lg:col-span-6 flex flex-col justify-center">
        <span class="text-primary uppercase tracking-wider font-bold text-xs mb-3">{t('experience.tag')}</span>
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-5 text-dark leading-tight">
          {t('experience.title')}
        </h2>
        <p class="text-gray-500 font-light leading-relaxed mb-6 text-sm">
          {t('experience.description')}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-8 mt-4">
          <div class="flex items-start space-x-3.5">
            <div class="flex-shrink-0 p-3 bg-secondary/10 text-secondary rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-sm text-secondary">{t('experience.benefits.dj.title')}</h3>
              <p class="text-[11px] text-gray-550 font-normal mt-1 leading-normal">
                {t('experience.benefits.dj.description')}
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3.5">
            <div class="flex-shrink-0 p-3 bg-secondary/10 text-secondary rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-sm text-secondary">{t('experience.benefits.mixology.title')}</h3>
              <p class="text-[11px] text-gray-550 font-normal mt-1 leading-normal">
                {t('experience.benefits.mixology.description')}
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3.5 sm:col-span-1">
            <div class="flex-shrink-0 p-3 bg-secondary/10 text-secondary rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-sm text-secondary">{t('experience.benefits.wellness.title')}</h3>
              <p class="text-[11px] text-gray-550 font-normal mt-1 leading-normal">
                {t('experience.benefits.wellness.description')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
    <svg viewBox="0 0 1440 140" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
      <defs>
        <filter id="line-shadow" x="-10%" y="-30%" width="120%" height="160%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#053e3a" flood-opacity="0.18" />
        </filter>
      </defs>
      <path d="M0,100 C240,60 480,120 720,90 C960,60 1200,120 1440,80 L1440,140 L0,140 Z" fill="#f8ece5" opacity="0.6"></path>
      <path d="M0,110 C360,70 720,130 1080,70 L1440,110 L1440,140 L0,140 Z" fill="#fbf7f4"></path>
      <path d="M0,140 Q720,40 1440,140 Z" fill="#fcfbf7"></path>
      <path d="M120,90 Q720,30 1320,90" stroke="var(--color-secondary)" stroke-width="2.5" stroke-linecap="round" filter="url(#line-shadow)" fill="none"></path>
    </svg>
  </div>
</section>
