---
import { useTranslations } from "../../i18n/utils";
import { getI18N } from "../../i18n/index";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;
const t = useTranslations(lang);
---

<section
  id="experience"
  class="pt-16 pb-36 md:pb-48 -mb-12 md:mb-0 bg-[#fcfbf7] relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-5 relative flex justify-center py-6">
        <div
          class="absolute w-[360px] h-[420px] bg-secondary/10 rounded-[120px_240px_120px_240px] blur-3xl -z-10"
        >
        </div>
        <div
          class="w-[320px] h-[400px] sm:w-[350px] sm:h-[440px] overflow-hidden rounded-[120px_240px_120px_240px] shadow-2xl relative z-10"
        >
          <img
            src="/img-food/food-beach-club-in-puerto-morelos.webp"
            alt="Delicious food on the beach"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="w-36 h-36 sm:w-40 sm:h-40 rounded-full overflow-hidden absolute bottom-[10px] right-2 sm:right-6 z-20 border-[6px] border-white shadow-xl"
        >
          <img
            src="/img-food/food-in-the-beach.webp"
            alt="Ocean water beach thumbnail"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <!-- LADO DERECHO: TEXTO EDITORIAL Y BENEFICIOS -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <span
          class="text-xs uppercase tracking-[0.25em] text-primary font-medium block mb-3"
        >
          {i18n.HOME.INTRO.tag}
        </span>
        <h2
          class="font-serif text-3xl md:text-4xl font-bold mb-4 text-[#4e8782] leading-tight"
        >
          {i18n.HOME.INTRO.title}
        </h2>
        <h3
          class="text-gray-550 font-normal leading-relaxed mb-8 text-sm max-w-2xl"
        >
          {i18n.HOME.INTRO.subtitle}
        </h3>
        <!-- CUADRÍCULA DE BENEFICIOS -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4 w-full"
        >
          <!-- 1. Transport (Icono de Autobús / Van) -->
          <article
            class="flex items-start space-x-4 p-4 rounded-xl bg-secondary/[0.02] border border-secondary/5 hover:bg-secondary/[0.04] hover:border-secondary/10 transition-all duration-300 group"
          >
            <div
              class="flex-shrink-0 p-2.5 bg-secondary/10 text-[#4e8782] rounded-lg group-hover:scale-105 transition-transform duration-300 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                <circle cx="7" cy="17" r="2"></circle>
                <circle cx="17" cy="17" r="2"></circle>
                <path
                  d="M5 17h2m2 0h6m2 0h2M3 17V9a2 2 0 012-2h14a2 2 0 012 2v8"
                ></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4
                class="font-bold text-[14px] text-dark/75 tracking-tight leading-snug"
              >
                {i18n.HOME.INTRO.BENEFITS.transport.title}
              </h4>
              {
                i18n.HOME.INTRO.BENEFITS.transport.description && (
                  <p class="text-[12px] text-gray-550 font-normal mt-1 leading-relaxed balance">
                    {i18n.HOME.INTRO.BENEFITS.transport.description}
                  </p>
                )
              }
            </div>
          </article>

          <!-- 2. Beach / Camastros (Icono de Sombrilla de Playa Real / Parasol) -->
          <article
            class="flex items-start space-x-4 p-4 rounded-xl bg-secondary/[0.02] border border-secondary/5 hover:bg-secondary/[0.04] hover:border-secondary/10 transition-all duration-300 group"
          >
            <div
              class="flex-shrink-0 p-2.5 bg-secondary/10 text-[#4e8782] rounded-lg group-hover:scale-105 transition-transform duration-300 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <!-- Sombrilla de playa clásica -->
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v18M12 3c3.5 0 7 2.5 7 6H5c0-3.5 3.5-6 7-6zM19 9a3 3 0 01-3 3H8a3 3 0 01-3-3"
                ></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4
                class="font-bold text-[14px] text-dark/75 tracking-tight leading-snug"
              >
                {i18n.HOME.INTRO.BENEFITS.beach.title}
              </h4>
              {
                i18n.HOME.INTRO.BENEFITS.beach.description && (
                  <p class="text-[12px] text-gray-550 font-normal mt-1 leading-relaxed">
                    {i18n.HOME.INTRO.BENEFITS.beach.description}
                  </p>
                )
              }
            </div>
          </article>

          <!-- 3. Sargassum / Sin Sargazo (Icono de Chispas / Limpieza / Destello) -->
          <article
            class="flex items-start space-x-4 p-4 rounded-xl bg-secondary/[0.02] border border-secondary/5 hover:bg-secondary/[0.04] hover:border-secondary/10 transition-all duration-300 group"
          >
            <div
              class="flex-shrink-0 p-2.5 bg-secondary/10 text-[#4e8782] rounded-lg group-hover:scale-105 transition-transform duration-300 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <!-- Icono de destellos/limpio/puro -->
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                ></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4
                class="font-bold text-[14px] text-dark/75 tracking-tight leading-snug"
              >
                {i18n.HOME.INTRO.BENEFITS.sargassum.title}
              </h4>
              {
                i18n.HOME.INTRO.BENEFITS.sargassum.description && (
                  <p class="text-[12px] text-gray-550 font-normal mt-1 leading-relaxed">
                    {i18n.HOME.INTRO.BENEFITS.sargassum.description}
                  </p>
                )
              }
            </div>
          </article>

          <!-- 4. Tacos y Sabores locales (Icono de Utensilios de Comida) -->
          <article
            class="flex items-start space-x-4 p-4 rounded-xl bg-secondary/[0.02] border border-secondary/5 hover:bg-secondary/[0.04] hover:border-secondary/10 transition-all duration-300 group"
          >
            <div
              class="flex-shrink-0 p-2.5 bg-secondary/10 text-[#4e8782] rounded-lg group-hover:scale-105 transition-transform duration-300 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <!-- Silueta estilizada de un taco con relleno -->
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 14a9 9 0 0118 0v1H3v-1z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 14c.5-2 2-4 6-4s5.5 2 6 4"></path>
                <!-- Detalles del relleno (carne/verdura) -->
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 10V9m4 1V8m4 2V9"></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4
                class="font-bold text-[14px] text-dark/75 tracking-tight leading-snug"
              >
                {i18n.HOME.INTRO.BENEFITS.tacos.title}
              </h4>
              {
                i18n.HOME.INTRO.BENEFITS.tacos.description && (
                  <p class="text-[12px] text-gray-550 font-normal mt-1 leading-relaxed">
                    {i18n.HOME.INTRO.BENEFITS.tacos.description}
                  </p>
                )
              }
            </div>
          </article>

          <!-- 5. DJ / Música / Ambiente (Icono de Notas Musicales) -->
          <article
            class="flex items-start space-x-4 p-4 rounded-xl bg-secondary/[0.02] border border-secondary/5 hover:bg-secondary/[0.04] hover:border-secondary/10 transition-all duration-300 group"
          >
            <div
              class="flex-shrink-0 p-2.5 bg-secondary/10 text-[#4e8782] rounded-lg group-hover:scale-105 transition-transform duration-300 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 19V6l12-3v13M9 10l12-3M9 14c0 1.657-1.343 3-3 3s-3-1.343-3-3 1.343-3 3-3 3 1.343 3 3zm12-2c0 1.657-1.343 3-3 3s-3-1.343-3-3 1.343-3 3-3 3 1.343 3 3z"
                ></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4
                class="font-bold text-[14px] text-dark/75 tracking-tight leading-snug"
              >
                {i18n.HOME.INTRO.BENEFITS.dj.title}
              </h4>
              {
                i18n.HOME.INTRO.BENEFITS.dj.description && (
                  <p class="text-[12px] text-gray-550 font-normal mt-1 leading-relaxed">
                    {i18n.HOME.INTRO.BENEFITS.dj.description}
                  </p>
                )
              }
            </div>
          </article>

          <!-- 6. Beach Crowded / Sin aglomeraciones (Icono de Usuarios / Grupo de personas Tachado u Oculto) -->
          <article
            class="flex items-start space-x-4 p-4 rounded-xl bg-secondary/[0.02] border border-secondary/5 hover:bg-secondary/[0.04] hover:border-secondary/10 transition-all duration-300 group"
          >
            <div
              class="flex-shrink-0 p-2.5 bg-secondary/10 text-[#4e8782] rounded-lg group-hover:scale-105 transition-transform duration-300 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <!-- Icono de grupo/personas libre de tumultos o exclusivo -->
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4
                class="font-bold text-[14px] text-dark/75 tracking-tight leading-snug"
              >
                {i18n.HOME.INTRO.BENEFITS.beachCrowded.title}
              </h4>
              {
                i18n.HOME.INTRO.BENEFITS.beachCrowded.description && (
                  <p class="text-[12px] text-gray-550 font-normal mt-1 leading-relaxed">
                    {i18n.HOME.INTRO.BENEFITS.beachCrowded.description}
                  </p>
                )
              }
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
  <!-- SVG DE CURVAS INFERIORES -->
  <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
    <svg
      viewBox="0 0 1440 140"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto overflow-visible"
    >
      <defs>
        <filter id="line-shadow" x="-10%" y="-30%" width="120%" height="160%">
          <feDropShadow
            dx="0"
            dy="5"
            stdDeviation="5"
            flood-color="#053e3a"
            flood-opacity="0.18"></feDropShadow>
        </filter>
      </defs>
      <path
        d="M0,100 C240,60 480,120 720,90 C960,60 1200,120 1440,80 L1440,140 L0,140 Z"
        fill="#f8ece5"
        opacity="0.6"></path>
      <path
        d="M0,110 C360,70 720,130 1080,70 L1440,110 L1440,140 L0,140 Z"
        fill="#fbf7f4"></path>
      <path d="M0,140 Q720,40 1440,140 Z" fill="#fcfbf7"></path>

      <path
        d="M0,90 Q720,30 1440,90"
        stroke="var(--color-secondary)"
        class="stroke-[4] md:stroke-[2.5]"
        stroke-linecap="round"
        filter="url(#line-shadow)"
        fill="none"></path>
    </svg>
  </div>
</section>
