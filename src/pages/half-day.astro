---
import Layout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HalfDayComponent from '../components/HalfDay.astro';
import Footer from '../components/Footer.astro';

const lang = 'pt';
---
<Layout title="Half Day" description="Half Day Tours" lang={lang}>
	<Navbar lang={lang} />
	<main class="flex-grow pt-20">
		<HalfDayComponent lang={lang} />
	</main>
	<Footer lang={lang} />
</Layout>
