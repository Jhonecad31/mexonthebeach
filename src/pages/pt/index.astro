---
import Layout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Experience from '../../components/sections/Experience.astro';
import BookingSection from '../../components/BookingSection.astro';
import Gallery from '../../components/sections/Gallery.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';
const lang = 'pt';
// `useTranslations` currently types its parameter as 'en' | 'es'.
// Cast through unknown to bypass the narrower union and allow other locales like 'pt'.
const t = useTranslations(lang as unknown as any) as any;
---
<Layout title={String(t(''))} description={String(t('SEO.HOME_PAGE.DESCRIPTION'))} lang={lang}>
	<Navbar lang={lang} />
	<main class="flex-grow">SEO.HOME_PAGE.TITLE
		<Hero lang={lang} />
		<Experience lang={lang} />
		<BookingSection lang={lang} />	
		<Gallery lang={lang} />
	</main>
	<Footer lang={lang} />
</Layout>
