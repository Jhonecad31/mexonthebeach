---
import '../styles/global.css';
import { getLangFromUrl } from "@/i18n/utils";
import Header from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
interface Props {
    title?: string;
    description?: string;
    offI18n?: boolean;
}
const lang = getLangFromUrl(Astro.url);
const { 
    title = "Mex on the Beach | Premium Beach Club", 
    description = "Experience the ultimate beach getaway, where sun, sand, and good vibes blend seamlessly. Premium sunbeds, mixology heaven, and curated culinary experiences.",
    offI18n = false
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
        <meta name="theme-color" content="#f15d2a" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="/images/beach-clud.jpeg" />
        <link rel="preload" href="/images/beach-clud.jpeg" as="image" />
    </head>
    <body class="min-h-screen flex flex-col">
        {/* Renderiza el Header pasándole el control de idioma opcional */}
        <Header />
        {/* El contenedor principal crece (flex-grow) para empujar el footer hacia abajo si hay poco contenido */}
        <main class="flex-grow">
            <slot />
        </main>
        {/* Renderiza el Footer al final */}
        <Footer />
    </body>
</html>